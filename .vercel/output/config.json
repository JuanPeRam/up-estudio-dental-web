{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/404\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/clinic\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/contact\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/member\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/messages\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/privacy-policy\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/services\\/blanqueamiento-dental\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/services\\/limpieza-bucal\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/services\\/medicina-estetica\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/services\\/revisiones-dentales\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/services\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/team\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		},
		{
			"src": "/.*",
			"dest": "_render",
			"status": 404
		}
	]
}
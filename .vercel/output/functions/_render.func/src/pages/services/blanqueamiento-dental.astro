---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Common/Header.astro";
import TeethWhitening from "@/components/Services/TeethWhitening.astro";
---

<Layout
    title="Blanqueamiento Dental"
    description="Blanqueamiento dental profesional y supervisado para recuperar el tono natural de tu sonrisa en Up Estudio Dental, Móstoles."
>
    <section id="service-hero">
        <Header title="Blanqueamiento Dental" description="" styles="bg-secondary/80" />
        <a href="/services" class="block text-center text-sm text-white/70 hover:text-corporative pb-8 transition">← Volver a Servicios</a>
    </section>
    <TeethWhitening />
</Layout>

<style>
    #service-hero {
        background-image: linear-gradient(
                to top right,
                rgba(19, 19, 19, 0.363),
                rgba(88, 88, 88, 0.671)
            ),
            url("img/UP-Gallery/Box22.jpg");
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
    }
</style>

---
import { team, getMemberByName } from "../../db/team";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return team.map(({ id }) => ({
    params: { id },
  }));
}

const { id } = Astro.params;
const memberData = getMemberByName(id);
---

<Layout description="" title={memberData?.name ?? ""}>
  <section class="w-full h-screen flex-center">
    {memberData?.name}
    <div class="h-[29rem] w-[20rem]">
      <img
        src={`../${memberData?.picture}`}
        alt={memberData?.name}
        transition:name={`${memberData?.id}-image`}
        class="object-cover w-full h-full"
      />
    </div>
  </section>
</Layout>

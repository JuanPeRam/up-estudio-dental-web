---
export const prerender = true;

import { team, getMemberByName } from "../../db/team";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return team.map(({ id }) => ({
    params: { id },
  }));
}

const { id } = Astro.params;
const memberData = getMemberByName(id);

const memberDescription = memberData
    ? `${memberData.name}${memberData.roles ? ` — ${memberData.roles.join(", ")}` : ""} en Up Estudio Dental y Estética, Móstoles.`
    : "Conoce al equipo de Up Estudio Dental y Estética.";
---

<Layout description={memberDescription} title={memberData?.name ?? ""}>
  <section class="w-full min-h-screen row-center flex-col">
    <article class="w-[50vw] column-center backdrop-blur-md rounded-md border max-w-[550px] min-w-[400px]">
      <h2 class="text-xl font-bold w-fit text-center p-5">{memberData?.name}</h2>
      <div class="w-[350px] h-[350px] p-5">
        <img
          src={`../${memberData?.picture}`}
          alt={memberData?.name}
          transition:name={`${memberData?.id}-image`}
          class="object-cover w-full h-full shadow-md object-center rounded-full"
        />
      </div>
      <article class="border-t p-5 backdrop-blur-md w-fit">
        <div class="text-pretty w-fit">{memberData?.description}</div>
      </article>
    </article>
  </section>
</Layout>

<style>
  section {
    background-image: linear-gradient(
        to top right,
        rgba(19, 19, 19, 0.363),
        rgba(88, 88, 88, 0.26)
      ),
      url("img/UP-Gallery/Office2.jpg");

    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }
</style>

---
/* type: service · ficha de un profesional
   hero split (texto a la izquierda, el retrato a la derecha); más del equipo (tres tiles); footer.closing */
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { team, getMemberByName } from "@/db/team";

export function getStaticPaths() {
  return team.map(({ id }) => ({ params: { id } }));
}

const { id } = Astro.params;
const m = getMemberByName(id)!;
const others = team.filter((x) => x.id !== id).slice(0, 3);
---

<Layout
  title={m.name}
  description={`${m.name}, ${m.roles.join(", ").toLowerCase()} en Up Estudio Dental y Estética, Móstoles.`}
  current="equipo"
  closeTitle="Pide cita con nuestro equipo"
  closeLine="Dinos qué necesitas y te damos cita con el especialista adecuado."
>
  <section class="hero hero--split" aria-labelledby="hero-h">
    <div class="wrap"><div class="hero-text grid hero__grid">
      <div class="hero__text span-5">
        <h1 id="hero-h">{m.name}</h1>
        <p class="hero__lead">{m.description}</p>
        <div class="btn-row"><a class="btn btn--primary" href="/contact#cita">Pedir cita</a><a class="btn btn--secondary" href="/team">Ver el equipo</a></div>
        <dl class="hero-facts">
          {m.roles.map((r: string, i: number) => <div><dt>{i === 0 ? "Especialidad" : "También"}</dt><dd>{r}</dd></div>)}
        </dl>
      </div>
      <div class="hero__media hero__media--portrait span-4 start-9">
        <img src={`/${m.picture}`} alt={m.name} width="420" height="600" fetchpriority="high" style="--ly-pos: 50% 20%" data-source="client" data-subject={m.name} />
      </div>
    </div></div>
  </section>

  <section class="section" id="mas-equipo" aria-labelledby="mas-h">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div><h2 id="mas-h">Más del equipo</h2><p>Trabajan juntos en cada caso que lo necesita.</p></div>
        <a class="link" href="/team">Ver todo el equipo</a>
      </div>
      <div class="grid">
        {
          others.map((o) => (
            <a class="tile tile--square span-4 m-zoom" href={`/member/${o.id}`}>
              <div class="tile__media"><img src={`/${o.picture}`} alt={o.name} width="420" height="420" loading="lazy" data-source="client" data-subject={o.name} /></div>
              <div class="tile__head"><h3>{o.name}</h3></div>
              <p class="tile__facts">{o.roles.join(" · ")}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

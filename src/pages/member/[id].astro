---
export const prerender = true;

import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/UI/Button.astro";
import TeamCard from "@/components/Cards/TeamCard.astro";
import CTABand from "@/components/UI/CTABand.astro";
import { team, getMemberByName } from "@/db/team";

export function getStaticPaths() {
  return team.map(({ id }) => ({ params: { id } }));
}

const { id } = Astro.params;
const member = getMemberByName(id)!;
const others = team.filter((m) => m.id !== id).slice(0, 3);
const description = `${member.name}${member.roles ? ` — ${member.roles.join(", ")}` : ""} en Up Estudio Dental y Estética, Móstoles.`;
---

<Layout title={member.name} description={description}>
  <section class="up-section pt-10">
    <div class="up-wrap flex flex-col gap-8">
      <nav class="up-crumbs" aria-label="Migas de pan">
        <a href="/team">Equipo</a><span aria-hidden="true">/</span><span aria-current="page">{member.name}</span>
      </nav>
      <div class="grid items-start gap-10 md:grid-cols-[minmax(0,380px)_1fr] lg:gap-16">
        <div class="up-cutout-photo w-full max-w-[320px] md:max-w-none">
          {member.portrait ? (
            <Image src={member.portrait} alt={member.name} widths={[400, 800]} sizes="(min-width: 768px) 380px, 320px" loading="eager" transition:name={`${member.id}-image`} />
          ) : (
            <img src={`/${member.picture}`} alt={member.name} width="420" height="560" transition:name={`${member.id}-image`} />
          )}
        </div>
        <div class="flex flex-col gap-6 md:pt-4">
          <p class="up-eyebrow">Nuestro equipo</p>
          <h1 class="up-h1">{member.name}</h1>
          {member.roles && <div class="up-team-roles">{member.roles.map((r) => <span class="up-badge">{r}</span>)}</div>}
          <p class="up-lead">{member.description}</p>
          <div class="flex flex-wrap gap-3 pt-2">
            <Button href="/contact" icon="calendar">Pedir cita</Button>
            <Button href="/team" variant="secondary" icon="arrow-left">Volver al equipo</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="up-section up-band-sand">
    <div class="up-wrap flex flex-col gap-10">
      <h2 class="up-h2">Más del equipo</h2>
      <div class="up-grid-team">
        {others.map((m) => <TeamCard id={m.id} name={m.name} roles={m.roles} picture={m.picture} portrait={m.portrait} />)}
      </div>
    </div>
  </section>

  <CTABand title="Pide cita con nuestro equipo" />
</Layout>

---
import { team, getMemberByName } from "../../db/team";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return team.map(({ id }) => ({
    params: { id },
  }));
}

const { id } = Astro.params;
const memberData = getMemberByName(id);
---

<Layout description="" title={memberData?.name ?? ""}>
  <section class="w-full min-h-screen flex-center flex-col">
    <h2 class="text-xl font-bold">{memberData?.name}</h2>
    <div class="w-[40ch] h-[25rem]">
      <img
        src={`../${memberData?.picture}`}
        alt={memberData?.name}
        transition:name={`${memberData?.id}-image`}
        class="object-cover w-full h-full rounded-md shadow-md object-center"
      />
    </div>

    <article class="max-w-[40ch] border p-5 backdrop-blur-md">
      <div>{memberData?.description}</div>
    </article>
  </section>
</Layout>

<style>
  section {
    background-image: linear-gradient(
        to top right,
        rgba(19, 19, 19, 0.363),
        rgba(88, 88, 88, 0.26)
      ),
      url("img/UP-Gallery/Office2.jpg");

    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }
</style>

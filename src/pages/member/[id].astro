---
export const prerender = true;

import { team, getMemberByName } from "../../db/team";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return team.map(({ id }) => ({
    params: { id },
  }));
}

const { id } = Astro.params;
const memberData = getMemberByName(id);

const memberDescription = memberData
    ? `${memberData.name}${memberData.roles ? ` — ${memberData.roles.join(", ")}` : ""} en Up Estudio Dental y Estética, Móstoles.`
    : "Conoce al equipo de Up Estudio Dental y Estética.";
---

<Layout description={memberDescription} title={memberData?.name ?? ""}>
  <section class="row-center w-full min-h-screen flex-col px-4 py-24">
    <article class="column-center w-full max-w-[550px] gap-5 rounded-xl border border-white/10 bg-secondary/90 p-8 shadow-lg">
      <div class="h-[220px] w-[220px]">
        <img
          src={`/${memberData?.picture}`}
          alt={memberData?.name}
          transition:name={`${memberData?.id}-image`}
          class="h-full w-full rounded-full object-cover object-center shadow-md"
        />
      </div>

      <div class="column-center gap-2">
        <h2 class="text-center text-2xl font-bold">{memberData?.name}</h2>
        {memberData?.roles && (
          <div class="flex flex-wrap justify-center gap-2">
            {memberData.roles.map((role) => (
              <span class="rounded-full bg-corporative/10 px-2 py-1 text-xs font-semibold text-corporative">
                {role}
              </span>
            ))}
          </div>
        )}
      </div>

      <p class="text-pretty text-center leading-relaxed text-white/80">
        {memberData?.description}
      </p>

      <a href="/team" class="text-sm font-bold text-white/60 hover:text-corporative"
        >← Volver al equipo</a
      >
    </article>
  </section>
</Layout>

<style>
  section {
    background-image: linear-gradient(
        to top right,
        rgba(19, 19, 19, 0.363),
        rgba(88, 88, 88, 0.26)
      ),
      url("img/UP-Gallery/Office2.jpg");

    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }
</style>

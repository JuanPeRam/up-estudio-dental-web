---
export const prerender = true;

import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/UI/Button.astro";
import TeamCard from "@/components/Cards/TeamCard.astro";
import CTABand from "@/components/UI/CTABand.astro";
import type { CollectionEntry } from "astro:content";
import { getEquipo } from "@/lib/contenido";

export async function getStaticPaths() {
  const team = await getEquipo();
  return team.map((entry) => ({ params: { id: entry.id }, props: { entry, others: team.filter((m) => m.id !== entry.id).slice(0, 3) } }));
}

interface Props {
  entry: CollectionEntry<"equipo">;
  others: CollectionEntry<"equipo">[];
}
const { entry, others } = Astro.props;
const member = { id: entry.id, ...entry.data };
const description = `${member.nombre}${member.especialidades.length ? ` — ${member.especialidades.join(", ")}` : ""} en Up Estudio Dental y Estética, Móstoles.`;
---

<Layout title={member.nombre} description={description}>
  <section class="up-section pt-10">
    <div class="up-wrap flex flex-col gap-8">
      <nav class="up-crumbs" aria-label="Migas de pan">
        <a href="/team">Equipo</a><span aria-hidden="true">/</span><span aria-current="page">{member.nombre}</span>
      </nav>
      <div class="grid items-start gap-10 md:grid-cols-[minmax(0,380px)_1fr] lg:gap-16">
        <div class="up-cutout-photo w-full max-w-[320px] md:max-w-none">
          <Image src={member.retrato} alt={member.retratoAlt} widths={[400, 800]} sizes="(min-width: 768px) 380px, 320px" loading="eager" />
        </div>
        <div class="flex flex-col gap-6 md:pt-4">
          <p class="up-eyebrow">Nuestro equipo</p>
          <h1 class="up-h1">{member.nombre}</h1>
          {member.especialidades.length > 0 && <div class="up-team-roles">{member.especialidades.map((r) => <span class="up-badge">{r}</span>)}</div>}
          <p class="up-lead">{member.biografia}</p>
          <div class="flex flex-wrap gap-3 pt-2">
            <Button href="/contact" icon="calendar">Pedir cita</Button>
            <Button href="/team" variant="secondary" icon="arrow-left">Volver al equipo</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="up-section up-band-sand">
    <div class="up-wrap flex flex-col gap-10">
      <h2 class="up-h2">Más del equipo</h2>
      <div class="up-grid-team">
        {others.map((m) => <TeamCard member={m} />)}
      </div>
    </div>
  </section>

  <CTABand title="Pide cita con nuestro equipo" />
</Layout>

---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/UI/PageHeader.astro";
import ClinicTour from "@/components/Clinic/ClinicTour.astro";
import CTABand from "@/components/UI/CTABand.astro";
---

<Layout
  title="La clínica dental en Móstoles"
  description="Visita guiada por Up Estudio Dental en Móstoles: entrada, recepción, sala de espera con zona infantil, gabinetes, despacho y aseos."
  breadcrumbs={[{ name: "Clínica", path: "/clinica" }]}
>
  <PageHeader
    title="Pasa, te enseñamos la clínica"
    lead="Una visita guiada como si vinieras a tu primera cita: de la puerta de la calle a tu gabinete, parada a parada."
  />

  <ClinicTour />

  <CTABand title="Ven a conocernos" description="La primera revisión gratuita es la mejor forma de ver la clínica y conocer al equipo." />
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Common/Header.astro";
import DentalCheckups from "@/components/Services/DentalCheckups.astro";
---

<Layout
    title="Revisiones Dentales"
    description="Revisión dental, estudio radiográfico y presupuesto totalmente gratuitos en Up Estudio Dental, Móstoles."
>
    <section id="service-hero">
        <Header title="Revisiones Dentales" description="" styles="bg-secondary/80" />
        <a href="/services" class="block text-center text-sm text-white/70 hover:text-corporative pb-8 transition">← Volver a Servicios</a>
    </section>
    <DentalCheckups />
</Layout>

<style>
    #service-hero {
        background-image: linear-gradient(
                to top right,
                rgba(19, 19, 19, 0.363),
                rgba(88, 88, 88, 0.671)
            ),
            url("img/UP-Gallery/Boxes.jpg");
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
    }
</style>

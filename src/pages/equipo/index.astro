---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/UI/PageHeader.astro";
import OurTeam from "@/components/OurTeam.astro";
import CTABand from "@/components/UI/CTABand.astro";
---

<Layout
  title="Dentistas en Móstoles: nuestro equipo"
  description="Conoce al equipo de Up Estudio Dental y Estética: ortodoncia, odontopediatría, cirugía e implantología, periodoncia e higiene dental en Móstoles."
  breadcrumbs={[{ name: "Equipo", path: "/equipo" }]}
>
  <PageHeader
    title="Las personas que cuidan de tu sonrisa"
    lead="Especialistas en odontología, cirugía e implantología, ortodoncia y periodoncia que trabajan juntos en la misma clínica y comparten los casos que lo necesitan."
  />
  <section class="up-section up-band-sand pt-12">
    <div class="up-wrap">
      <OurTeam />
    </div>
  </section>
  <CTABand title="Pide cita con nuestro equipo" description="Dinos qué necesitas y te asignamos al especialista adecuado desde la primera visita." />
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/UI/PageHeader.astro";
import ServiceCard from "@/components/Cards/ServiceCard.astro";
import ServiceDetail from "@/components/Services/ServiceDetail.astro";
import { getServicios } from "@/lib/contenido";

const services = await getServicios();
const requestedSlug = Astro.url.searchParams.get("servicio");
const active = services.find((s) => s.id === requestedSlug) ?? services[0];
---

<Layout
    title={requestedSlug && active ? active.data.titulo : "Servicios"}
    description="Revisiones gratuitas, limpieza bucal, y blanqueamiento dental en Móstoles. Precio orientativo, duración y cómo es cada tratamiento."
>
    <PageHeader
        eyebrow="Servicios"
        title="Tratamientos para toda la familia"
        lead="Elige un tratamiento para ver en qué consiste, cuánto dura y cómo es el proceso. Si tienes dudas, la primera revisión es gratuita."
    />

    <section class="up-band-tint py-12" aria-label="Elige un tratamiento">
        <div class="up-wrap">
            <div class="up-grid-4">
                {services.map((s) => <ServiceCard service={s} active={s.id === active?.id} />)}
            </div>
        </div>
    </section>

    <div id="detalle">
        {active && <ServiceDetail service={active} />}
    </div>
</Layout>

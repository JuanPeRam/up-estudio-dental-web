---
import Layout from "../layouts/Layout.astro";
import Header from "@/components/Common/Header.astro";
import ServiceSelector from "@/components/Services/ServiceSelector.astro";
import DentalCheckups from "@/components/Services/DentalCheckups.astro";
import DentalCleaning from "@/components/Services/DentalCleaning.astro";
import TeethWhitening from "@/components/Services/TeethWhitening.astro";
import SteticMedicine from "@/components/Services/SteticMedicine.astro";
import { services, defaultServiceSlug } from "@/constants/services";

const requestedSlug = Astro.url.searchParams.get("servicio");
const activeSlug = services.some((service) => service.slug === requestedSlug)
    ? (requestedSlug as string)
    : defaultServiceSlug;
---

<Layout
    title="Servicios"
    description="Descubre todos los servicios de Up Estudio Dental y Estética: revisiones, medicina estética, blanqueamiento dental y limpieza bucal, cada uno con su ficha detallada."
>
    <section class="min-h-screen" id="services-section">
        <Header
            title="Nuestros Servicios"
            description="Elige un tratamiento para ver toda la información: precio orientativo, duración y cómo es el proceso 😎"
        />
        <div class="mx-auto max-w-screen-xl px-4 pb-16 lg:px-6">
            <ServiceSelector active={activeSlug} />
        </div>

        <div id="detalle">
            {activeSlug === "revisiones-dentales" && <DentalCheckups />}
            {activeSlug === "medicina-estetica" && <SteticMedicine />}
            {activeSlug === "blanqueamiento-dental" && <TeethWhitening />}
            {activeSlug === "limpieza-bucal" && <DentalCleaning />}
        </div>
    </section>
</Layout>

<style>
    #services-section {
        background-image: linear-gradient(
                to top right,
                rgba(19, 19, 19, 0.363),
                rgba(88, 88, 88, 0.671)
            ),
            url("img/UP-Gallery/Boxes.jpg");

        background-attachment: fixed;
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
    }
</style>

---
import Layout from "@/layouts/Layout.astro";
import CarrouselWrapper from "@/components/Carrousel/CarrouselWrapper.astro";
import Header from "@/components/Common/Header.astro";
---

<Layout title="Clínica" description="Todos nuestros componentes">
  <section class="" id="clinic-section">
    <Header title="Clínica" description="" />
    <CarrouselWrapper />
  </section>
</Layout>

<style>
  #clinic-section {
    background-image: linear-gradient(
        to bottom left,
        rgba(0, 0, 0, 0.363),
        rgba(255, 255, 255, 0.342)
      ),
      url("img/UP-Gallery/Kitchen.jpg");

    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }
</style>

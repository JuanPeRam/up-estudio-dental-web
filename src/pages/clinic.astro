---
import Layout from "@/layouts/Layout.astro";
import Gallery from "@/components/Gallery/Gallery.astro";
import Header from "@/components/Common/Header.astro";
---

<Layout
  title="Clínica"
  description="Recorre nuestras instalaciones en Móstoles: gabinetes, sala de espera y equipamiento de Up Estudio Dental y Estética."
>
  <section id="clinic-section">
    <Header
      title="Nuestra Clínica"
      description="Un espacio pensado para que te sientas como en casa, con la última tecnología en cada gabinete."
    />
    <div class="bg-secondary/60 pb-16">
      <Gallery />
    </div>
  </section>
</Layout>

<style>
  #clinic-section {
    background-image: linear-gradient(
        to bottom left,
        rgba(0, 0, 0, 0.363),
        rgba(255, 255, 255, 0.342)
      ),
      url("img/UP-Gallery/Kitchen.jpg");

    background-attachment: fixed;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }
</style>

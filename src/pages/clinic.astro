---
/* type: service · la clínica
   deal: hero photo (con caja); secciones: instalaciones (muro de fotos), familias (services-list:
   filas + foto), cómo llegar (visita + fachada), footer.closing */
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Visit from "@/components/Visit.astro";
import gallery from "@/db/gallery";
import zonaInfantil from "@/img/UP-Gallery/Rest-room.jpg";
import salaEspera from "@/img/UP-Gallery/Up-WaitRoom.jpg";
---

<Layout
  title="Clínica"
  description="Las instalaciones de Up Estudio Dental en la calle Andrómeda, Móstoles: recepción, sala de espera con zona infantil, gabinetes y radiografía."
  current="clinica"
  closeTitle="Ven a conocer la clínica"
  closeLine="La primera revisión es gratis: la mejor forma de ver la clínica y al equipo."
>
  <section class="hero hero--photo" data-calm="left" aria-labelledby="hero-h">
    <Image class="hero__bg" src={zonaInfantil} alt="Sala de espera con tipi, mesas infantiles y butacas" widths={[800, 1400, 1864]} sizes="(min-width: 1024px) 100vw, 230vw" loading="eager" fetchpriority="high" style="--ly-pos: 50% 50%; --ly-pos-phone: 35% 50%" data-source="client" data-subject="la sala de espera" />
    <div class="wrap"><div class="hero-text">
      <div class="hero__text">
        <h1 id="hero-h">Clínica en la calle Andrómeda</h1>
        <p class="hero__lead">Recepción, sala de espera con zona de juegos, gabinetes dentales y de estética y radiografía en la propia clínica, en Móstoles.</p>
        <div class="btn-row"><a class="btn btn--primary" href="/contact#cita">Pedir cita</a><a class="btn btn--secondary" href="#como-llegar">Cómo llegar</a></div>
      </div>
    </div></div>
  </section>

  <section class="section" id="instalaciones" aria-labelledby="inst-h">
    <div class="wrap">
      <div class="section-head"><h2 id="inst-h">Las instalaciones</h2><p>Luz natural, plantas y gabinetes amplios, todo en planta baja.</p></div>
      <div class="wall fill">
        {gallery.slice(0, 12).map((g, i) => <Image class={i === 0 || i === 7 ? "big" : undefined} src={g.src} alt={g.alt} widths={[400, 800]} sizes={i === 0 || i === 7 ? "(min-width: 1024px) 640px, 100vw" : "(min-width: 1024px) 320px, 50vw"} data-source="client" data-subject={g.alt} />)}
      </div>
    </div>
  </section>

  <section class="section" id="familias" aria-labelledby="fam-h">
    <div class="wrap">
      <div class="grid grid--top fill">
        <div class="span-6">
          <div class="section-head"><h2 id="fam-h">Pensada para venir con niños</h2><p>Los peques juegan mientras esperan y los adultos se relajan.</p></div>
          <ul class="rows">
            <li><span class="rows__name">Zona de juegos</span><p>Tipi, cuentos y mesas a su altura en la sala de espera.</p></li>
            <li><span class="rows__name">Odontopediatría</span><p>La Dra. Cristina Umérez lleva más de 25 años tratando a niños.</p></li>
            <li><span class="rows__name">Ambiente tranquilo</span><p>Luz natural, plantas y música relajante en todas las salas.</p></li>
          </ul>
        </div>
        <div class="frame frame--photo frame--fill span-6 start-7">
          <Image class="frame__img" src={salaEspera} alt="Sala de espera con butacas blancas y rincón infantil" widths={[680]} sizes="(min-width: 1024px) 628px, 100vw" data-source="client" data-subject="la sala de espera" />
        </div>
      </div>
    </div>
  </section>

  <Visit />
</Layout>

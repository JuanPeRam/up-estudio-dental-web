---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import Linea from "@/components/Marca/Linea.astro";
import Hero from "@/components/Home/Hero.astro";
import Etapas from "@/components/Home/Etapas.astro";
import FirstVisit from "@/components/Home/FirstVisit.astro";
import TeamPreview from "@/components/Home/TeamPreview.astro";
import ClinicIntro from "@/components/Home/ClinicIntro.astro";
import TrustBar from "@/components/Home/TrustBar.astro";
import Opinions from "@/components/Comments/Opinions.astro";
import Cierre from "@/components/Home/Cierre.astro";
import { emergencies } from "@/constants/personal";
---

<Layout
  title="Inicio"
  description={`Clínica dental familiar en Móstoles: odontopediatría, ortodoncia e Invisalign, implantes y blanqueamiento Philips Zoom. Primera revisión gratuita${emergencies ? " y urgencias 24 h" : ""}.`}
>
  {/* La línea de la sonrisa une, por este orden: el diente de la cabecera, cada etapa, la revisión
      gratuita, el equipo, la clínica y el corazón del cierre. */}
  <div class="up-linea-host">
    <Linea />
    <Hero />
    <Etapas />
    <FirstVisit />
    <TeamPreview />
    <ClinicIntro />
    <TrustBar />
    <div data-linea-campo="claro"><Opinions /></div>
    <Cierre />
  </div>
</Layout>

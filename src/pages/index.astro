---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Home/Hero.astro";
import TrustBar from "@/components/Home/TrustBar.astro";
import ServicesPreview from "@/components/Home/ServicesPreview.astro";
import ClinicIntro from "@/components/Home/ClinicIntro.astro";
import Technology from "@/components/Home/Technology.astro";
import TeamPreview from "@/components/Home/TeamPreview.astro";
import Opinions from "@/components/Comments/Opinions.astro";
import CTABand from "@/components/UI/CTABand.astro";
import { emergencies } from "@/constants/personal";
---

<Layout
  title="Inicio"
  description={`Clínica dental familiar en Móstoles: odontopediatría, ortodoncia, Invisalign, implantes y blanqueamiento Philips Zoom. Primera revisión gratis${emergencies ? " y urgencias 24 h" : ""}.`}
>
  <Hero />
  <TrustBar />
  <ServicesPreview />
  <ClinicIntro />
  <Technology />
  <TeamPreview />
  <Opinions />
  <CTABand />
</Layout>

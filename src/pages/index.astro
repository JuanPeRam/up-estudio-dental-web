---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Home/Hero.astro";
import TrustBar from "@/components/Home/TrustBar.astro";
import ServicesPreview from "@/components/Home/ServicesPreview.astro";
import ClinicIntro from "@/components/Home/ClinicIntro.astro";
import FirstVisit from "@/components/Home/FirstVisit.astro";
import Technology from "@/components/Home/Technology.astro";
import TeamPreview from "@/components/Home/TeamPreview.astro";
import Opinions from "@/components/Comments/Opinions.astro";
import CTABand from "@/components/UI/CTABand.astro";
import { emergencies } from "@/constants/personal";
---

<Layout
  title="Inicio"
  description={`Clínica dental familiar en Móstoles: odontopediatría, ortodoncia e Invisalign, implantes y blanqueamiento Philips Zoom. Primera revisión gratuita${emergencies ? " y urgencias 24 h" : ""}.`}
>
  <Hero />
  <TrustBar />
  {/* Primero lo que diferencia a la clínica para una familia y la primera revisión gratuita; luego el catálogo. */}
  <ClinicIntro />
  <FirstVisit />
  <ServicesPreview />
  <Technology />
  <TeamPreview />
  <Opinions />
  <CTABand title="Pide cita para toda la familia" description="Escríbenos por WhatsApp o llámanos. Te contestamos en horario de clínica." />
</Layout>

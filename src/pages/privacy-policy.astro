---
export const prerender = true;

import LegalLayout from "@/layouts/LegalLayout.astro";
import LegalSection from "@/components/Legal/LegalSection.astro";
import { fixedNumber } from "@/constants/personal";
---

<LegalLayout
    title="Política de privacidad"
    description="Política de privacidad de Up Estudio Dental y Estética: responsable del tratamiento, finalidad, base legal y derechos de los interesados."
    lastUpdated="agosto de 2026"
>
    <LegalSection title="1. Responsable del tratamiento">
        <p>Up Estudio Dental y Estética, S.L.</p>
        <p>Domicilio: C. Andrómeda, 48, 28938 Móstoles, Madrid, España.</p>
        <p>Correo electrónico: info@upestudiodental.com</p>
        <p>Teléfono: {fixedNumber}</p>
    </LegalSection>

    <LegalSection title="2. Finalidad del tratamiento">
        <p>
            Los datos personales que nos facilitas a través del formulario de contacto
            (nombre, correo electrónico y mensaje) se utilizan exclusivamente para
            responder a tu solicitud de información o de cita, y para gestionar la
            relación que, en su caso, se establezca con la clínica.
        </p>
    </LegalSection>

    <LegalSection title="3. Legitimación">
        <p>
            La base legal para el tratamiento de tus datos es tu consentimiento
            expreso, otorgado al marcar la casilla de aceptación de esta política de
            privacidad antes de enviar el formulario de contacto.
        </p>
    </LegalSection>

    <LegalSection title="4. Destinatarios">
        <p>
            Tus datos no se ceden a terceros, salvo obligación legal. No se realizan
            transferencias internacionales de datos.
        </p>
    </LegalSection>

    <LegalSection title="5. Derechos de los interesados">
        <p>
            Puedes ejercer tus derechos de acceso, rectificación, supresión,
            oposición, limitación del tratamiento y portabilidad de tus datos, en los
            términos establecidos en el Reglamento (UE) 2016/679 (RGPD) y la Ley
            Orgánica 3/2018 (LOPDGDD), enviando un correo a
            <a href="mailto:info@upestudiodental.com" class="font-bold text-black hover:text-corporative"
                >info@upestudiodental.com</a
            > o por escrito a nuestro domicilio social, adjuntando copia de un
            documento que acredite tu identidad.
        </p>
        <p>
            Asimismo, tienes derecho a presentar una reclamación ante la Agencia
            Española de Protección de Datos
            (<a href="https://www.aepd.es" target="_blank" rel="noopener noreferrer" class="font-bold text-black hover:text-corporative">www.aepd.es</a>)
            si consideras que el tratamiento de tus datos no se ajusta a la normativa
            vigente.
        </p>
    </LegalSection>

    <LegalSection title="6. Plazo de conservación">
        <p>
            Tus datos se conservarán mientras sean necesarios para atender tu
            solicitud y, posteriormente, durante los plazos legalmente exigibles.
        </p>
    </LegalSection>

    <LegalSection title="7. Formulario de contacto">
        <p>
            Los campos marcados como obligatorios en nuestro formulario de contacto
            son necesarios para poder gestionar tu solicitud; su no cumplimentación
            impedirá que podamos atenderla.
        </p>
    </LegalSection>
</LegalLayout>

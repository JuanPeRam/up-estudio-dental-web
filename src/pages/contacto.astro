---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/UI/PageHeader.astro";
import Form from "@/components/Contact/Form.astro";
import HoursCard from "@/components/UI/HoursCard.astro";
import Button from "@/components/UI/Button.astro";
import Notice from "@/components/UI/Notice.astro";
import { contact, whatsappLink } from "@/constants/personal";
---

<Layout
    title="Pedir cita en el dentista en Móstoles"
    description="Pide cita en Up Estudio Dental y Estética, Móstoles: formulario, WhatsApp, teléfono y horario. Urgencias odontológicas 24 h."
    breadcrumbs={[{ name: "Contacto", path: "/contacto" }]}
>
    <PageHeader
        eyebrow="Contacto"
        title="Pide tu cita"
        lead="Escríbenos por el formulario o por WhatsApp, o llámanos. Te respondemos en horario de clínica y atendemos urgencias las 24 horas."
    >
        <div class="flex flex-wrap gap-3">
            <Button href={whatsappLink("Hola, me gustaría pedir cita.")} icon="whatsapp" external aria-label="Escribir por WhatsApp (se abre en otra pestaña)">Escribir por WhatsApp</Button>
            <Button href={contact.landline.href} variant="secondary" icon="phone">{contact.landline.display}</Button>
        </div>
    </PageHeader>

    <section class="up-section pt-12">
        <div class="up-wrap grid grid-cols-1 items-start gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-12">
            <Form />
            <div class="flex flex-col gap-6 lg:sticky lg:top-[calc(var(--nav-h)+24px)]">
                <HoursCard />
                <div class="up-hours">
                    <p class="up-eyebrow">Dirección</p>
                    <p class="m-0 font-semibold text-ink">{contact.address}</p>
                    <a class="up-tel" href={`mailto:${contact.email}`}><Icon name="mail" class="up-icon" />{contact.email}</a>
                    <Button href={contact.mapsUrl} variant="secondary" icon="pin" external block aria-label="Cómo llegar (abre Google Maps en otra pestaña)">Cómo llegar</Button>
                </div>
                <Notice>
                    <b>Política de cancelación.</b> Confirma o anula tu cita llamando con antelación. Sin confirmación previa no podemos garantizar la disponibilidad.
                </Notice>
            </div>
        </div>
    </section>
</Layout>

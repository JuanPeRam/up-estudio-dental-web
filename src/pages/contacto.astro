---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/UI/PageHeader.astro";
import Form from "@/components/Contact/Form.astro";
import HoursCard from "@/components/UI/HoursCard.astro";
import Button from "@/components/UI/Button.astro";
import Notice from "@/components/UI/Notice.astro";
import { contact, emergencies, whatsappLink } from "@/constants/personal";
import { handleContactForm, SENT_PARAM, SENT_URL, type ContactFormState } from "@/lib/contactForm";

let form: ContactFormState = { status: "idle", values: {} };

if (Astro.request.method === "POST") {
    let ip = "desconocida";
    try {
        ip = Astro.clientAddress;
    } catch {
        // Sin dirección (no debería pasar en Vercel): todos comparten el mismo cupo.
    }
    form = await handleContactForm(Astro.request, ip);
    if (form.status === "sent") {
        // Se redirige para que recargar la página no vuelva a mandar el mensaje.
        return Astro.redirect(SENT_URL, 303);
    }
    Astro.response.status = form.status === "limited" ? 429 : form.status === "failed" ? 503 : 400;
} else if (Astro.url.searchParams.get(SENT_PARAM) === "1") {
    form = { status: "sent", values: {} };
}
// La respuesta depende del envío: que ninguna caché la comparta.
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<Layout
    title="Pedir cita en el dentista en Móstoles"
    description={`Pide cita en Up Estudio Dental y Estética, Móstoles: formulario, WhatsApp, teléfono y horario.${emergencies ? ` ${emergencies.long}.` : ""}`}
    breadcrumbs={[{ name: "Contacto", path: "/contacto" }]}
>
    <PageHeader
        title="Pide tu cita"
        lead={`Escríbenos por el formulario o por WhatsApp, o llámanos. Te respondemos en horario de clínica${emergencies ? " y atendemos urgencias las 24 horas" : ""}.`}
    >
        <div class="flex flex-wrap gap-3">
            <Button href={whatsappLink("Hola, me gustaría pedir cita.")} icon="whatsapp" external aria-label="Escribir por WhatsApp (se abre en otra pestaña)">Escribir por WhatsApp</Button>
            <Button href={contact.landline.href} variant="secondary" icon="phone">{contact.landline.display}</Button>
        </div>
    </PageHeader>

    <section class="up-section pt-12">
        <div class="up-wrap grid grid-cols-1 items-start gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-12">
            <Form state={form} />
            <div class="flex flex-col gap-6 lg:sticky lg:top-[calc(var(--nav-h)+24px)]">
                <HoursCard />
                <div class="up-hours">
                    <p class="up-eyebrow">Dirección</p>
                    <p class="m-0 font-semibold text-ink">{contact.address}</p>
                    <a class="up-tel" href={`mailto:${contact.email}`}><Icon name="mail" class="up-icon" />{contact.email}</a>
                    <Button href={contact.mapsUrl} variant="secondary" icon="pin" external block aria-label="Cómo llegar (abre Google Maps en otra pestaña)">Cómo llegar</Button>
                </div>
                <Notice>
                    <b>Política de cancelación.</b> Confirma o anula tu cita llamando con antelación. Sin confirmación previa no podemos garantizar la disponibilidad.
                </Notice>
            </div>
        </div>
    </section>
</Layout>

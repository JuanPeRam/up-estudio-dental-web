---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Página no encontrada"
    description="La página que buscas no existe. Vuelve al inicio de Up Estudio Dental y Estética o consulta los tratamientos."
    doc
>
    <section class="section section--doc" aria-labelledby="doc-h">
        <div class="wrap">
            <div class="section-head">
                <h1 id="doc-h">No encontramos esta página</h1>
                <p>Puede que el enlace haya cambiado. Vuelve al inicio o mira los tratamientos.</p>
            </div>
            <div class="btn-row"><a class="btn btn--primary" href="/contact#cita">Pedir cita</a><a class="btn btn--secondary" href="/services">Ver tratamientos</a></div>
        </div>
    </section>
</Layout>

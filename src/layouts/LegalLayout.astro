---
import Layout from "./Layout.astro";
import PageHeader from "@/components/UI/PageHeader.astro";

interface Props {
    title: string;
    description: string;
    lastUpdated: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<Layout title={title} description={description}>
    <PageHeader title={title} lead={`Última actualización: ${lastUpdated}`} />
    <section class="up-section pt-12">
        <div class="up-wrap">
            <article class="up-prose">
                <slot />
            </article>
        </div>
    </section>
</Layout>

---
import { ViewTransitions } from "astro:transitions";
import NavBar from "@/components/Common/NavBar.astro";
import Footer from "@/components/Common/Footer.astro";
import License from "@/components/License.astro";
import "@fontsource/libre-baskerville";
import '@/styles/tailwind.css'
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="image" content="img/UP-Gallery/Uplogo.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="keywords"
      content="dentista, dental, estudio, Móstoles, Madrid, España, Familiar, familiar, family, dentist, teeth, dientes, blanqueamiento, estética, up, arriba, profesional, respeto, asequible, recomendado, nuevo, nueva, novedosa, clínica, clinica, aparato, braquets, bráquets, invisaline, invisible, bonita,"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://upestudiodental.vercel.app/" />
    <meta property="og:title" content="Up Estudio Dental y estética - Home" />
    <meta
      property="og:description"
      content="Página web oficial de Up estudio dental y estética, tu dentista de confianza en Móstoles, Madrid."
    />
    <meta
      property="og:image"
      content="https://upestudiodental.vercel.app/img/UP-Gallery/Uplogo.webp"
    />

    <link rel="icon" type="image/svg+xml" href="img/up-logo.png" />

    <title>{`Up Estudio Dental y estética - ${title}`}</title>
    <ViewTransitions />
  </head>
  <body class="bg-secondary w-full text-primary min-h-screen">
    <NavBar />
    <main>
      <slot />
    </main>
    <Footer />
    <License />
    <style is:global>
      #header-nav {
        animation: blur linear both;
        animation-timeline: scroll();
        animation-range: 0 100vh;
      }

      @keyframes blur {
        to {
          box-shadow:
            0px 5px 50px -5px hsla(0, 0%, 100%, 0.1),
            0px 0px 0 1px hsla(0, 0%, 100%, 0.1);
          background: #2d2d2d56;
          backdrop-filter: blur(10px);
        }
      }

      ::-webkit-scrollbar {
        width: 10px;
        border-radius: 10px;
      }

      ::-webkit-scrollbar-thumb {
        border-radius: 10px;
        background-color: theme("colors.primary");
        border: 2px solid transparent;
        background-clip: content-box;
      }

      ::-webkit-scrollbar-thumb:active {
        background-color: #666;
      }

      ::-webkit-scrollbar-track {
        background: var(--background-image);
      }

      ::-webkit-scrollbar-corner {
        background: var(--background-image);
      }
    </style>
  </body>
</html>

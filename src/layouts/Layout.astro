---
import { ViewTransitions } from "astro:transitions";
import NavBar from "@/components/Common/NavBar.astro";
import Footer from "@/components/Common/Footer.astro";
import License from "@/components/License.astro";
import "@fontsource/libre-baskerville";
import '@/styles/tailwind.css'
import { fixedNumber } from "@/constants/personal";
import socials from "@/constants/socials";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const pageTitle = `Up Estudio Dental y estética - ${title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL("img/UP-Gallery/Uplogo.webp", Astro.site).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: "Up Estudio Dental y Estética",
  image: ogImageURL,
  url: Astro.site?.toString(),
  telephone: `+34${fixedNumber}`,
  email: "info@upestudiodental.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "C. Andrómeda, 48",
    addressLocality: "Móstoles",
    addressRegion: "Madrid",
    postalCode: "28938",
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.312004675050765,
    longitude: -3.8613156547374,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "10:00",
      closes: "13:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "16:00",
      closes: "20:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "10:00",
      closes: "14:00",
    },
  ],
  sameAs: socials.map((social) => social.link),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="image" content={ogImageURL} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/img/up-logo.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <ViewTransitions />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-secondary w-full text-primary min-h-screen">
    <NavBar />
    <main>
      <slot />
    </main>
    <Footer />
    <License />
    <style is:global>
      * {
        scroll-behavior: smooth;
      }

      ::selection {
        background-color: #77c6c1;
        color: #121212;
      }

      a,
      button {
        outline-offset: 3px;
      }
      a:focus-visible,
      button:focus-visible {
        outline: 2px solid #77c6c1;
        border-radius: 4px;
      }

      #header-nav {
        animation: header-solidify linear both;
        animation-timeline: scroll();
        animation-range: 0 60vh;
      }

      @keyframes header-solidify {
        to {
          box-shadow:
            0 10px 40px -12px hsla(0, 0%, 0%, 0.45),
            0 0 0 1px hsla(176, 45%, 60%, 0.12);
          background: hsla(0, 0%, 7%, 0.75);
          backdrop-filter: blur(14px);
        }
      }

      ::-webkit-scrollbar {
        width: 10px;
        border-radius: 10px;
      }

      ::-webkit-scrollbar-thumb {
        border-radius: 10px;
        background-color: #77c6c1;
        border: 2px solid transparent;
        background-clip: content-box;
      }

      ::-webkit-scrollbar-thumb:active {
        background-color: #5aa19c;
      }

      ::-webkit-scrollbar-track {
        background: #121212;
      }

      ::-webkit-scrollbar-corner {
        background: #121212;
      }
    </style>
  </body>
</html>

---
import { ViewTransitions } from "astro:transitions";
import NavBar from "@/components/Common/NavBar.astro";
import Footer from "@/components/Common/Footer.astro";
import License from "@/components/License.astro";
import "@fontsource/libre-baskerville";
import '@/styles/tailwind.css'
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="image" content="img/UP-Gallery/Uplogo.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="keywords"
      content="dentista, dental, estudio, Móstoles, Madrid, España, Familiar, familiar, family, dentist, teeth, dientes, blanqueamiento, estética, up, arriba, profesional, respeto, asequible, recomendado, nuevo, nueva, novedosa, clínica, clinica, aparato, braquets, bráquets, invisaline, invisible, bonita,"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://upestudiodental.vercel.app/" />
    <meta property="og:title" content="Up Estudio Dental y estética - Home" />
    <meta
      property="og:description"
      content="Página web oficial de Up estudio dental y estética, tu dentista de confianza en Móstoles, Madrid."
    />
    <meta
      property="og:image"
      content="https://upestudiodental.vercel.app/img/UP-Gallery/Uplogo.webp"
    />

    <link rel="icon" type="image/svg+xml" href="img/up-logo.png" />

    <title>{`Up Estudio Dental y estética - ${title}`}</title>
    <ViewTransitions />
  </head>
  <body class="bg-secondary w-full text-primary min-h-screen">
    <NavBar />
    <main>
      <slot />
    </main>
    <Footer />
    <License />
    <style is:global>
      * {
        scroll-behavior: smooth;
      }

      ::selection {
        background-color: #77c6c1;
        color: #121212;
      }

      a,
      button {
        outline-offset: 3px;
      }
      a:focus-visible,
      button:focus-visible {
        outline: 2px solid #77c6c1;
        border-radius: 4px;
      }

      #header-nav {
        animation: header-solidify linear both;
        animation-timeline: scroll();
        animation-range: 0 60vh;
      }

      @keyframes header-solidify {
        to {
          box-shadow:
            0 10px 40px -12px hsla(0, 0%, 0%, 0.45),
            0 0 0 1px hsla(176, 45%, 60%, 0.12);
          background: hsla(0, 0%, 7%, 0.75);
          backdrop-filter: blur(14px);
        }
      }

      ::-webkit-scrollbar {
        width: 10px;
        border-radius: 10px;
      }

      ::-webkit-scrollbar-thumb {
        border-radius: 10px;
        background-color: #77c6c1;
        border: 2px solid transparent;
        background-clip: content-box;
      }

      ::-webkit-scrollbar-thumb:active {
        background-color: #5aa19c;
      }

      ::-webkit-scrollbar-track {
        background: #121212;
      }

      ::-webkit-scrollbar-corner {
        background: #121212;
      }
    </style>
  </body>
</html>

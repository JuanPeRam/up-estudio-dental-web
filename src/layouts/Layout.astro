---
import NavBar from "@/components/Common/NavBar.astro";
import Footer from "@/components/Common/Footer.astro";
import MobileActionBar from "@/components/Common/MobileActionBar.astro";
import "@fontsource-variable/figtree";
import "@fontsource-variable/playfair-display";
import "@fontsource-variable/playfair-display/wght-italic.css";
// Las fuentes que se ven nada más entrar se precargan, también la cursiva de la palabra de acento del
// titular: si llegan tarde, el titular cambia de ancho al sustituir a la de reserva, gana una línea y
// empuja el resto de la cabecera (CLS).
import playfairItalicUrl from "@fontsource-variable/playfair-display/files/playfair-display-latin-wght-italic.woff2?url";
import playfairUrl from "@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url";
import figtreeUrl from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";
import '@/styles/tailwind.css'
import '@/styles/motion.css'
import { clinic, contact, fixedNumber, openingHours } from "@/constants/personal";
import socials from "@/constants/socials";
import { getImage } from "astro:assets";
import defaultShareImage from "@/img/up/equipo-grupo.webp";

interface Props {
  title: string;
  description: string;
  /** Migas de pan para Google (BreadcrumbList), sin contar el inicio. */
  breadcrumbs?: { name: string; path: string }[];
  /** Datos estructurados propios de la página, además del Dentist común. */
  jsonLd?: Record<string, unknown>[];
  /** Foto para compartir en redes; por defecto, el equipo. */
  shareImage?: ImageMetadata;
  /** Páginas que no deben salir en Google (la 404): noindex y sin canonical. */
  noindex?: boolean;
}

const { title, description, breadcrumbs = [], jsonLd = [], shareImage = defaultShareImage, noindex = false } = Astro.props;

const pageTitle = title === "Inicio" ? "Up Estudio Dental y Estética · Dentista en Móstoles" : `${title} · Up Estudio Dental`;
// Sin barra final, igual que el sitemap (trailingSlash: "never").
const pathname = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, "") : "/";
const canonicalURL = new URL(pathname, Astro.site).toString();
// Imagen de 1200×630 en JPG: el formato que todas las redes muestran en grande.
const ogImage = await getImage({ src: shareImage, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });
const ogImageURL = new URL(ogImage.src, Astro.site).toString();
const clinicImage = shareImage === defaultShareImage ? ogImage : await getImage({ src: defaultShareImage, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });
const clinicImageURL = new URL(clinicImage.src, Astro.site).toString();
const logoURL = new URL("img/up-logo.png", Astro.site).toString();
const siteURL = new URL("/", Astro.site).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  "@id": `${siteURL}#clinica`,
  name: clinic.name,
  legalName: clinic.legalName,
  image: clinicImageURL,
  logo: logoURL,
  url: siteURL,
  telephone: `+34${fixedNumber}`,
  email: contact.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: clinic.streetAddress,
    addressLocality: clinic.locality,
    addressRegion: clinic.region,
    postalCode: clinic.postalCode,
    addressCountry: clinic.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    ...clinic.geo,
  },
  openingHoursSpecification: openingHours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  sameAs: socials.map((social) => social.link),
};

const breadcrumbData = breadcrumbs.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [{ name: "Inicio", path: "/" }, ...breadcrumbs].map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: new URL(b.path, Astro.site).toString(),
      })),
    }
  : null;
const schemas = [structuredData, breadcrumbData, ...jsonLd].filter(Boolean);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#c1e4e2" />
    <meta name="generator" content={Astro.generator} />
    <!-- Misma verificación que la web de Wix: la propiedad de Search Console sigue verificada tras la migración. -->
    <meta name="google-site-verification" content="4ebBHgPfrJOPgCBNzjcEleF1nSa6YK4aMKs4kPYpsQ8" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={clinic.name} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preload" href={playfairUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfairItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/img/up-logo.png" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

    <title>{pageTitle}</title>

    {/* Fotos que se abren al llegar a ellas (src/styles/motion.css, [data-reveal]). Va en línea para que
        no dependa de la red: este script es el único que las oculta, y solo las que quedan por debajo de
        la primera pantalla. Si no se ejecuta, o se pide menos movimiento, la página se ve entera. */}
    <script is:inline>
      (() => {
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const start = () => {
          const fold = innerHeight * 0.9;
          const pending = Array.from(document.querySelectorAll("[data-reveal]")).filter((el) => el.getBoundingClientRect().top > fold);
          if (!pending.length) return;
          const io = new IntersectionObserver(
            (entries) => {
              let order = 0;
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const el = entry.target;
                io.unobserve(el);
                // Las que entran a la vez se abren una tras otra, con un tope para no hacer esperar.
                el.style.setProperty("--reveal-delay", Math.min(order++, 4) * 70 + "ms");
                let done = false;
                const open = () => {
                  if (done) return;
                  done = true;
                  el.classList.replace("is-pending", "is-in");
                };
                // Se espera a que la foto haya cargado para no abrir un marco vacío (con un tope de 1,5 s).
                const img = el.querySelector("img");
                if (img && !img.complete) {
                  img.addEventListener("load", open, { once: true });
                  img.addEventListener("error", open, { once: true });
                  setTimeout(open, 1500);
                } else open();
              }
            },
            { rootMargin: "0px 0px -8% 0px" },
          );
          pending.forEach((el) => {
            el.classList.add("is-pending");
            io.observe(el);
          });
        };
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once: true });
        else start();
      })();
    </script>

    {/* "<" escapado: un texto del panel con "</script>" no puede cerrar la etiqueta antes de tiempo. */}
    {schemas.map((schema) => <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />)}
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-md focus:bg-raised focus:px-4 focus:py-2 focus:font-semibold">Saltar al contenido</a>
    <NavBar />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
  </body>
</html>

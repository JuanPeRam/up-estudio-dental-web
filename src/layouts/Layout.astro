---
import Nav from "@/components/Nav.astro";
import Closing from "@/components/Closing.astro";
import "@fontsource-variable/figtree";
import "@fontsource-variable/newsreader";
import { fixedNumber } from "@/constants/personal";
import socials from "@/constants/socials";

interface Props {
  title: string;
  description: string;
  /** Palabra de la navegación de esta página (aria-current) */
  current?: "tratamientos" | "clinica" | "equipo" | "contacto";
  /** Dónde se pide cita: el formulario de esta página (#cita) o la página de contacto */
  actionHref?: string;
  /** Cierre del pie: titular y línea */
  closeTitle?: string;
  closeLine?: string;
  /** Página sin el sistema de pantallas (textos legales) */
  doc?: boolean;
}

const {
  title,
  description,
  current,
  actionHref = "/contact#cita",
  closeTitle,
  closeLine,
  doc = false,
} = Astro.props;

const pageTitle = title === "Inicio" ? "Up Estudio Dental y Estética · Dentista en Móstoles" : `${title} · Up Estudio Dental y Estética`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL("img/UP-Gallery/Uplogo.webp", Astro.site).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: "Up Estudio Dental y Estética",
  image: ogImageURL,
  url: Astro.site?.toString(),
  telephone: `+34${fixedNumber}`,
  email: "info@upestudiodental.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "C. Andrómeda, 48",
    addressLocality: "Móstoles",
    addressRegion: "Madrid",
    postalCode: "28938",
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.312004675050765,
    longitude: -3.8613156547374,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "10:00",
      closes: "13:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "16:00",
      closes: "20:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "10:00",
      closes: "14:00",
    },
  ],
  sameAs: socials.map((social) => social.link),
};
---

<!doctype html>
<html lang="es" data-type="service" data-radius="soft" data-buttons="block" data-motion>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="site-kind" content="other" />
    <meta name="page-type" content="service" />
    <meta name="theme-color" content="#f6f8f7" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <link rel="icon" type="image/png" href="/img/up-logo.png" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="stylesheet" href="/kit/system.css" />
    <link rel="stylesheet" href="/kit/ui/cards.css" />
    <link rel="stylesheet" href="/kit/motion/motion.css" />
    <link rel="stylesheet" href="/kit/backgrounds/backgrounds.css" />
    <link rel="stylesheet" href="/kit/layout/layout.css" />
    <link rel="stylesheet" href="/kit/icons/icon.css" />
    <link rel="stylesheet" href="/site.css" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <Nav current={current} actionHref={actionHref} />
    <main id="top">
      <slot />
    </main>
    {doc ? <Closing actionHref={actionHref} compact /> : <Closing actionHref={actionHref} title={closeTitle} line={closeLine} />}
    <nav class="actionbar" aria-label="Contacto rápido">
      <a class="btn btn--secondary" href="tel:+34919931329">Llamar</a>
      <a class="btn btn--primary" href={actionHref}>Pedir cita</a>
    </nav>

    <script type="module" src="/kit/system.js" is:inline></script>
    <script type="module" src="/kit/motion/motion.js" is:inline></script>
    <script type="module" src="/kit/layout/layout.js" is:inline></script>
  </body>
</html>

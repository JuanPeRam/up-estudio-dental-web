---
import { Icon } from "astro-icon/components";
import Notice from "@/components/UI/Notice.astro";
import { clinic, contact } from "@/constants/personal";
import { sendContactEmail } from "@/lib/contactEmail";

const subjects = ["Pedir cita", "Revisión gratuita", "Limpieza bucal", "Blanqueamiento dental", "Otra consulta"];

// "invalid": faltan datos o están mal; "failed": los datos están bien pero el correo no salió.
let status: "idle" | "sent" | "invalid" | "failed" = "idle";
// Lo que escribió la persona, para no perderlo si hay que mostrar el formulario otra vez.
let values: Record<string, string> = {};

if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const get = (key: string, max: number) => (data.get(key)?.toString() ?? "").trim().slice(0, max);
        values = { name: get("name", 120), email: get("email", 200), phone: get("phone", 40), subject: get("subject", 60), message: get("message", 5000) };

        // Campo trampa: invisible para personas, los bots lo rellenan. Se finge éxito sin enviar.
        if (get("website", 200)) {
            status = "sent";
        } else if (!values.name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email) || !values.message || !data.get("privacy")) {
            status = "invalid";
        } else {
            const result = await sendContactEmail({
                name: values.name,
                email: values.email,
                phone: values.phone || undefined,
                subject: subjects.includes(values.subject) ? values.subject : undefined,
                message: values.message,
            });
            if (result.ok) {
                status = "sent";
            } else {
                console.error(`Formulario de contacto: ${result.error}`);
                status = "failed";
            }
        }
    } catch (error) {
        console.error("Formulario de contacto:", error);
        status = "invalid";
    }
}
const fields = [
    { id: "name", label: "Nombre", type: "text", autocomplete: "name", placeholder: "Tu nombre y apellido", required: true, error: "Escribe tu nombre para saber cómo dirigirnos a ti." },
    { id: "email", label: "Correo electrónico", type: "email", autocomplete: "email", placeholder: "tu@correo.com", required: true, error: "Revisa el correo: debe tener la forma nombre@dominio.com." },
    { id: "phone", label: "Teléfono", optional: true, type: "tel", autocomplete: "tel", placeholder: "600 000 000", required: false, error: "" },
] as const;
---

{
    status === "sent" ? (
        <div class="up-form" id="contact-form">
            <Notice tone="success"><b>Mensaje enviado.</b> Te respondemos en horario de clínica, normalmente el mismo día.</Notice>
            <p class="up-small">Si es urgente, llámanos al <a class="up-link" href={contact.landline.href}>{contact.landline.display}</a>.</p>
        </div>
    ) : (
        <form method="POST" class="up-form" id="contact-form" novalidate>
            <div class="flex flex-col gap-1">
                <h2 class="up-h3">Escríbenos</h2>
                <p class="up-small">Te contestamos en horario de clínica, normalmente el mismo día.</p>
            </div>

            {status === "invalid" && (
                <Notice tone="danger"><b>No hemos podido enviar el mensaje.</b> Revisa el nombre, el correo, el mensaje y la casilla de privacidad, o llámanos al {contact.landline.display}.</Notice>
            )}
            {status === "failed" && (
                <Notice tone="danger"><b>No hemos podido enviar el mensaje por un problema técnico.</b> Inténtalo de nuevo en unos minutos, escríbenos a <a class="up-link" href={`mailto:${contact.email}`}>{contact.email}</a> o llámanos al {contact.landline.display}.</Notice>
            )}

            <div class="up-hp" aria-hidden="true">
                <label for="f-website">No rellenes este campo</label>
                <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div class="up-form-2">
                {fields.map((f) => (
                    <div class="up-field">
                        <label for={`f-${f.id}`}>{f.label} {"optional" in f && <span>(opcional)</span>}</label>
                        <input class="up-input" id={`f-${f.id}`} name={f.id} type={f.type} autocomplete={f.autocomplete} placeholder={f.placeholder} required={f.required} value={values[f.id]} aria-describedby={f.error ? `f-${f.id}-e` : undefined} inputmode={f.type === "tel" ? "tel" : undefined} />
                        {f.error && <span class="up-error" id={`f-${f.id}-e`} hidden><Icon name="alert" class="up-icon" />{f.error}</span>}
                    </div>
                ))}
                <div class="up-field">
                    <label for="f-subject">Motivo</label>
                    <select class="up-input" id="f-subject" name="subject">
                        {subjects.map((s) => <option selected={s === values.subject}>{s}</option>)}
                    </select>
                </div>
            </div>

            <div class="up-field">
                <label for="f-message">Mensaje</label>
                <textarea class="up-input" id="f-message" name="message" required placeholder="Cuéntanos qué necesitas y qué horario te viene mejor." aria-describedby="f-message-h f-message-e">{values.message}</textarea>
                <span class="up-hint" id="f-message-h">No hace falta que nos cuentes detalles de tu salud: los vemos contigo en consulta.</span>
                <span class="up-error" id="f-message-e" hidden><Icon name="alert" class="up-icon" />Cuéntanos en pocas palabras qué necesitas.</span>
            </div>

            <div class="up-field">
                <label class="up-check" for="f-privacy">
                    <input type="checkbox" id="f-privacy" name="privacy" required aria-describedby="f-privacy-e" />
                    <span>He leído y acepto la <a class="up-link" href="/politica-privacidad">política de privacidad</a></span>
                </label>
                <span class="up-error" id="f-privacy-e" hidden><Icon name="alert" class="up-icon" />Necesitamos tu consentimiento para responderte.</span>
            </div>

            <div class="up-form-legal">
                <p><b>Información básica sobre protección de datos</b></p>
                <p><b>Responsable:</b> {clinic.legalName}. <b>Finalidad:</b> responder a tu consulta o solicitud de cita. <b>Legitimación:</b> tu consentimiento, también para los datos de salud que decidas incluir en el mensaje. <b>Destinatarios:</b> no cedemos tus datos a terceros salvo obligación legal; nuestros proveedores de alojamiento web y correo (Vercel, Resend y Arsys) los tratan por encargo nuestro, con posibles transferencias a EE. UU. con las garantías del RGPD. <b>Derechos:</b> acceso, rectificación, supresión, oposición, limitación y portabilidad, escribiendo a <a class="up-link" href={`mailto:${contact.email}`}>{contact.email}</a>. Más información en la <a class="up-link" href="/politica-privacidad">política de privacidad</a>.</p>
            </div>

            <button class="up-btn up-btn-primary up-btn-block" type="submit">Enviar mensaje</button>
        </form>
    )
}

<script>
    function initForm() {
        const form = document.querySelector<HTMLFormElement>("form#contact-form");
        if (!form || form.dataset.bound) return;
        form.dataset.bound = "true";
        const controls = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]"));

        const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
            const ok = el.checkValidity();
            el.setAttribute("aria-invalid", ok ? "false" : "true");
            const err = document.getElementById(`${el.id}-e`);
            if (err) err.hidden = ok;
            return ok;
        };
        controls.forEach((el) => {
            el.addEventListener("blur", () => el.value && check(el));
            el.addEventListener("input", () => el.getAttribute("aria-invalid") === "true" && check(el));
            el.addEventListener("change", () => el.getAttribute("aria-invalid") === "true" && check(el));
        });
        form.addEventListener("submit", (e) => {
            const invalid = controls.filter((el) => !check(el));
            if (invalid.length) {
                e.preventDefault();
                invalid[0].focus();
            }
        });
    }
    initForm();
</script>

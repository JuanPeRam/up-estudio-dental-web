---
import { Icon } from "astro-icon/components";
import Notice from "@/components/UI/Notice.astro";
import { clinic, contact } from "@/constants/personal";
import { subjects, type ContactFormState } from "@/lib/contactForm";

// El envío se procesa en la página (src/pages/contacto.astro), que es la única que puede redirigir.
interface Props { state?: ContactFormState }
const { status, values } = Astro.props.state ?? { status: "idle", values: {} };
const fields = [
    { id: "name", label: "Nombre", type: "text", autocomplete: "name", placeholder: "Tu nombre y apellido", required: true, error: "Escribe tu nombre para saber cómo dirigirnos a ti." },
    { id: "email", label: "Correo electrónico", type: "email", autocomplete: "email", placeholder: "tu@correo.com", required: true, error: "Revisa el correo: debe tener la forma nombre@dominio.com." },
    { id: "phone", label: "Teléfono", optional: true, type: "tel", autocomplete: "tel", placeholder: "600 000 000", required: false, error: "" },
] as const;
---

{
    status === "sent" ? (
        <div class="up-form" id="contact-form">
            <Notice tone="success" tabindex="-1" data-autofocus><b>Mensaje enviado.</b> Te respondemos en horario de clínica, normalmente el mismo día.</Notice>
            <p class="up-small">Si es urgente, llámanos al <a class="up-link" href={contact.landline.href}>{contact.landline.display}</a>.</p>
        </div>
    ) : (
        <form method="POST" action="/contacto#contact-form" class="up-form" id="contact-form" novalidate>
            <div class="flex flex-col gap-1">
                <h2 class="up-h3">Escríbenos</h2>
                <p class="up-small">Te contestamos en horario de clínica, normalmente el mismo día.</p>
            </div>

            {status === "invalid" && (
                <Notice tone="danger" role="alert" tabindex="-1" data-autofocus><b>No hemos podido enviar el mensaje.</b> Revisa el nombre, el correo, el mensaje y la casilla de privacidad, o llámanos al {contact.landline.display}.</Notice>
            )}
            {status === "limited" && (
                <Notice tone="danger" role="alert" tabindex="-1" data-autofocus><b>Has enviado varios mensajes seguidos.</b> Espera unos minutos antes de volver a intentarlo, o llámanos al {contact.landline.display}.</Notice>
            )}
            {status === "failed" && (
                <Notice tone="danger" role="alert" tabindex="-1" data-autofocus><b>No hemos podido enviar el mensaje por un problema técnico.</b> Inténtalo de nuevo en unos minutos, escríbenos a <a class="up-link" href={`mailto:${contact.email}`}>{contact.email}</a> o llámanos al {contact.landline.display}.</Notice>
            )}

            <div class="up-hp" aria-hidden="true">
                <label for="f-website">No rellenes este campo</label>
                <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div class="up-form-2">
                {fields.map((f) => (
                    <div class="up-field">
                        <label for={`f-${f.id}`}>{f.label} {"optional" in f && <span>(opcional)</span>}</label>
                        <input class="up-input" id={`f-${f.id}`} name={f.id} type={f.type} autocomplete={f.autocomplete} placeholder={f.placeholder} required={f.required} value={values[f.id]} inputmode={f.type === "tel" ? "tel" : undefined} />
                        {f.error && <span class="up-error" id={`f-${f.id}-e`} hidden><Icon name="alert" class="up-icon" />{f.error}</span>}
                    </div>
                ))}
                <div class="up-field">
                    <label for="f-subject">Motivo</label>
                    <select class="up-input" id="f-subject" name="subject">
                        {subjects.map((s) => <option selected={s === values.subject}>{s}</option>)}
                    </select>
                </div>
            </div>

            <div class="up-field">
                <label for="f-message">Mensaje</label>
                <textarea class="up-input" id="f-message" name="message" required placeholder="Cuéntanos qué necesitas y qué horario te viene mejor." aria-describedby="f-message-h">{values.message}</textarea>
                <span class="up-hint" id="f-message-h">No hace falta que nos cuentes detalles de tu salud: los vemos contigo en consulta.</span>
                <span class="up-error" id="f-message-e" hidden><Icon name="alert" class="up-icon" />Cuéntanos en pocas palabras qué necesitas.</span>
            </div>

            <div class="up-field">
                <label class="up-check" for="f-privacy">
                    <input type="checkbox" id="f-privacy" name="privacy" required checked={values.privacy === "on"} />
                    <span>He leído y acepto la <a class="up-link" href="/politica-privacidad">política de privacidad</a></span>
                </label>
                <span class="up-error" id="f-privacy-e" hidden><Icon name="alert" class="up-icon" />Necesitamos tu consentimiento para responderte.</span>
            </div>

            <div class="up-form-legal">
                <p><b>Información básica sobre protección de datos</b></p>
                <p><b>Responsable:</b> {clinic.legalName.replace(/\.$/, "")}. <b>Finalidad:</b> responder a tu consulta o solicitud de cita. <b>Legitimación:</b> tu consentimiento, también para los datos de salud que decidas incluir en el mensaje. <b>Destinatarios:</b> no cedemos tus datos a terceros salvo obligación legal; nuestros proveedores de alojamiento web y correo (Vercel, Resend y Arsys) los tratan por encargo nuestro, con posibles transferencias a EE. UU. con las garantías del RGPD. <b>Derechos:</b> acceso, rectificación, supresión, oposición, limitación y portabilidad, escribiendo a <a class="up-link" href={`mailto:${contact.email}`}>{contact.email}</a>. Más información en la <a class="up-link" href="/politica-privacidad">política de privacidad</a>.</p>
            </div>

            <button class="up-btn up-btn-primary up-btn-block" type="submit"><span class="up-spinner" aria-hidden="true"></span><span data-label>Enviar mensaje</span></button>
        </form>
    )
}

<script>
    // Tras enviar, la página vuelve con un aviso (enviado o error) y se le da el foco para que se vea
    // y el lector de pantalla lo lea. Se espera a que cargue: el salto a #contact-form que hace el
    // navegador al llegar le quitaría el foco si se le diera antes.
    const notice = document.querySelector<HTMLElement>("#contact-form [data-autofocus]");
    if (notice) {
        const focusNotice = () => requestAnimationFrame(() => notice.focus());
        if (document.readyState === "complete") focusNotice();
        else window.addEventListener("load", focusNotice, { once: true });
    }

    function initForm() {
        const form = document.querySelector<HTMLFormElement>("form#contact-form");
        if (!form || form.dataset.bound) return;
        form.dataset.bound = "true";
        const controls = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]"));

        const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
            const ok = el.checkValidity();
            el.setAttribute("aria-invalid", ok ? "false" : "true");
            const err = document.getElementById(`${el.id}-e`);
            if (err) {
                err.hidden = ok;
                // El mensaje de error solo se asocia al campo mientras se ve (un aria-describedby que apunta
                // a un elemento oculto se lee igual); la ayuda fija del campo, si la tiene, se conserva.
                const hint = el.dataset.hint ?? (el.dataset.hint = el.getAttribute("aria-describedby") ?? "");
                const ids = ok ? hint : `${hint} ${err.id}`.trim();
                if (ids) el.setAttribute("aria-describedby", ids);
                else el.removeAttribute("aria-describedby");
            }
            return ok;
        };
        controls.forEach((el) => {
            el.addEventListener("blur", () => el.value && check(el));
            el.addEventListener("input", () => el.getAttribute("aria-invalid") === "true" && check(el));
            el.addEventListener("change", () => el.getAttribute("aria-invalid") === "true" && check(el));
        });
        // Enviar tarda uno o dos segundos (sale un correo): el botón lo dice y no admite un segundo envío.
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const label = submit?.querySelector<HTMLElement>("[data-label]");
        const idleText = label?.textContent ?? "";
        const setSending = (sending: boolean) => {
            submit?.classList.toggle("is-loading", sending);
            submit?.setAttribute("aria-disabled", String(sending));
            if (label) label.textContent = sending ? "Enviando…" : idleText;
        };
        form.addEventListener("submit", (e) => {
            const invalid = controls.filter((el) => !check(el));
            if (invalid.length) {
                e.preventDefault();
                invalid[0].focus();
                return;
            }
            if (submit?.classList.contains("is-loading")) {
                e.preventDefault();
                return;
            }
            setSending(true);
        });
        // Al volver atrás, el navegador puede restaurar la página tal como quedó: el botón vuelve a su estado.
        window.addEventListener("pageshow", (e) => e.persisted && setSending(false));
    }
    initForm();
</script>

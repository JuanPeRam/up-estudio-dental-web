---
import { Icon } from "astro-icon/components";
import Button from "./Button.astro";
import { contact, whatsappLink } from "@/constants/personal";

interface Props {
  title?: string;
  description?: string;
  /** Tratamiento para el mensaje prerredactado de WhatsApp */
  service?: string;
}

const {
  title = "Pide tu primera revisión gratuita",
  description = "Incluye exploración, radiografías y presupuesto por escrito, sin compromiso.",
  service,
} = Astro.props;

const message = service ? `Hola, me gustaría pedir cita para ${service}.` : "Hola, me gustaría pedir cita.";
---

<section class="up-cta">
  <div class="up-wrap up-cta-in">
    <div class="flex flex-col gap-3">
      <h2 class="up-h2">{title}</h2>
      <p>{description}</p>
    </div>
    <div class="flex flex-col gap-4">
      <div class="flex flex-wrap gap-3">
        <Button href={whatsappLink(message)} icon="whatsapp" external aria-label="Pedir cita por WhatsApp (se abre en otra pestaña)">Pedir cita por WhatsApp</Button>
        <Button href="/contacto" variant="secondary">Escribir por el formulario</Button>
      </div>
      <div class="up-cta-phones">
        <a href={contact.mobile.href} aria-label={`Llamar al móvil ${contact.mobile.display}`}><Icon name="phone" class="up-icon" />{contact.mobile.display}<small>móvil</small></a>
        <a href={contact.landline.href} aria-label={`Llamar al fijo ${contact.landline.display}`}><Icon name="landline" class="up-icon" />{contact.landline.display}<small>fijo</small></a>
      </div>
    </div>
  </div>
</section>

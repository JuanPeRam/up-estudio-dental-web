---
import { Icon } from "astro-icon/components";
import { contact, emergencies, emergencyPhone } from "@/constants/personal";

interface Props {
  compact?: boolean;
  class?: string;
}
const { compact = false, class: extra } = Astro.props;
---

<aside class:list={["up-hours", extra]} aria-label="Horario y teléfonos">
  {compact && emergencies ? <span class="up-hours-urg">{emergencies.short}</span> : <p class="up-eyebrow">Horario</p>}
  <dl>
    {
      contact.hours.map((h) => (
        <>
          <dt>{h.days}</dt>
          <dd>{h.times.map((t) => <span class="block">{t}</span>)}</dd>
        </>
      ))
    }
  </dl>
  <hr />
  {!compact && emergencies && emergencyPhone && <a class="up-hours-urg" href={emergencyPhone.href}>{emergencies.short}: llama al {emergencyPhone.display}</a>}
  <a class="up-tel" href={contact.mobile.href}><Icon name="phone" class="up-icon" />{contact.mobile.display}<small>Móvil y WhatsApp</small></a>
  <a class="up-tel" href={contact.landline.href}><Icon name="landline" class="up-icon" />{contact.landline.display}<small>Fijo</small></a>
</aside>

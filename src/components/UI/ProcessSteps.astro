---
interface Props {
  steps: { title: string; text: string }[];
  /** Nivel del título de cada paso: uno más que el encabezado de la sección que los contiene. */
  level?: 3 | 4 | 5;
}
const { steps, level = 3 } = Astro.props;
const Heading = `h${level}` as const;
---

<ol class="up-steps">
  {
    steps.map((s) => (
      <li class="up-step">
        <div>
          <Heading class="up-h4">{s.title}</Heading>
          <p class="up-small">{s.text}</p>
        </div>
      </li>
    ))
  }
</ol>

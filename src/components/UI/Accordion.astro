---
import { Icon } from "astro-icon/components";

interface Props {
  items: { question: string; answer: string }[];
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---

<div class="up-acc">
  {
    items.map((item, i) => (
      <details open={openFirst && i === 0}>
        <summary>
          {item.question}
          <Icon name="plus" class="up-icon" />
        </summary>
        <p>{item.answer}</p>
      </details>
    ))
  }
</div>

---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  crumb?: { label: string; href: string };
}
const { eyebrow, title, lead, crumb } = Astro.props;
---

<section class="up-ph">
  <div class="up-wrap up-ph-in">
    <div class="flex flex-col gap-3">
      {
        crumb && (
          <nav class="up-crumbs" aria-label="Migas de pan">
            <a href={crumb.href}>{crumb.label}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{title.replace(/<[^>]+>/g, "")}</span>
          </nav>
        )
      }
      <p class="up-eyebrow">{eyebrow}</p>
      <h1 class="up-h1" set:html={title} />
    </div>
    <div class="flex flex-col gap-6">
      {lead && <p class="up-lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>

---
interface Props {
  title: string;
  lead?: string;
  align?: "left" | "center" | "split";
  as?: "h1" | "h2";
}
const { title, lead, align = "left", as: Tag = "h2" } = Astro.props;
---

<header class:list={["up-sh", align === "center" && "up-sh-center", align === "split" && "up-sh-split"]}>
  {
    align === "split" ? (
      <>
        <div class="flex flex-col gap-3">
          <Tag class="up-h2" set:html={title} />
        </div>
        <div class="flex flex-col gap-4">
          {lead && <p class="up-lead">{lead}</p>}
          <slot />
        </div>
      </>
    ) : (
      <>
        <Tag class="up-h2" set:html={title} />
        {lead && <p class="up-lead">{lead}</p>}
        <slot />
      </>
    )
  }
</header>

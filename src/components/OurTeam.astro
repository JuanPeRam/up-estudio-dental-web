---
import { team } from "../db/team";
---

<section
  class="w-full flex justify-center pt-20 flex-col relative"
  id="team-section"
>
  <section
    class="flex flex-wrap gap-32 justify-center my-10 animate-slide-in-top"
  >
    {
      team.map((row) => (
        <a
          class="w-[20rem] sm:w-[25rem] team-card flex-col justify-center rounded-lg transition-shadow overflow-hidden backdrop-blur-sm items-center h-fit shadow-lg flex hover:shadow-2xl group"
          href={`member/${row.id}`}
        >
          <div class="h-[29rem] w-full relative">
            <img
              src={row.picture}
              alt={`${row.name} picture`}
              class="object-cover w-full h-full group-hover:brightness-110 transition"
              loading="lazy"
              transition:name={`${row.id}-image`}
            />
          </div>

          <div class="h-[10rem] p-5 flex flex-col items-start justify-between w-full bg-contrast/80 group-hover:bg-contrast transition">
            <h2 class="text-2xl font-bold">{row.name}</h2>
            <div class="flex justify-between w-full items-center">
              <div class="flex gap-2">
                {row.roles?.map((role) => (
                  <div class=" text-xs">{role}</div>
                ))}
              </div>
              <div class="text-sm group-hover:underline">{`Mostrar más`}</div>
            </div>
          </div>
        </a>
      ))
    }
  </section>
</section>

<style>
  #member-description {
    transition: opacity 0.2s ease;
  }

  @keyframes grow {
    from{
      transform: scale(0);
    }
    to{
      transform: scale(1);
    }
    0%{
      transform: scale(0);
    }
  }

  .team-card{
    animation: grow both linear;
    animation-timeline: view();
    animation-range: entry -100% cover 50%;
  }
</style>

---
import { team } from "../db/team";
---

<section class="w-full flex justify-center pt-20 pb-24 flex-col relative" id="team-section">
  <div class="mx-auto grid w-full max-w-screen-xl grid-cols-1 gap-8 px-4 sm:grid-cols-2 lg:grid-cols-3 lg:px-6">
    {
      team.map((row) => (
        <a
          class="group flex flex-col overflow-hidden rounded-xl border border-white/10 bg-secondary/80 shadow-lg transition-all duration-200 hover:-translate-y-1 hover:border-corporative/50 hover:shadow-2xl"
          href={`member/${row.id}`}
        >
          <div class="h-72 w-full overflow-hidden">
            <img
              src={`/${row.picture}`}
              alt={`${row.name} picture`}
              class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
              loading="lazy"
              transition:name={`${row.id}-image`}
            />
          </div>

          <div class="flex flex-1 flex-col items-start justify-between gap-3 p-5">
            <div class="flex flex-col gap-2">
              <h2 class="text-xl font-bold">{row.name}</h2>
              {row.roles && (
                <div class="flex flex-wrap gap-2">
                  {row.roles.map((role) => (
                    <span class="rounded-full bg-corporative/10 px-2 py-1 text-xs font-semibold text-corporative">
                      {role}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <span class="text-sm font-bold text-white/60 group-hover:text-corporative">
              Ver perfil →
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>

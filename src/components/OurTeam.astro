---
// Cuadro del equipo con tarjetas profesionales. Los datos se editan en /keystatic (colección «Equipo»).
import TeamCard from "@/components/Cards/TeamCard.astro";
import { getEquipo } from "@/lib/contenido";

const team = await getEquipo();
---

<ul class="up-dcards">
  {team.map((m) => <li><TeamCard member={m} headingLevel="h2" bio transition /></li>)}
</ul>

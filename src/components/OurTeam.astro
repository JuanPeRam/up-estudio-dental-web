---
// Retratos recortados sobre aqua. Los datos se editan en /keystatic (colección «Equipo»).
import { Image } from "astro:assets";
import { getEquipo } from "@/lib/contenido";

const team = await getEquipo();
---

<div class="up-grid-team">
  {
    team.map((m) => (
      <a class="up-cutout" href={`/equipo/${m.id}`} id={m.id}>
        <div class="up-cutout-photo">
          <Image src={m.data.retrato} alt={m.data.retratoAlt} widths={[360, 700]} sizes="(min-width: 1000px) 380px, 45vw" />
        </div>
        <div class="flex flex-col gap-2">
          <h2 class="up-h4">{m.data.nombre}</h2>
          <div class="up-team-roles">{m.data.especialidades.slice(0, 3).map((r) => <span class="up-badge">{r}</span>)}</div>
        </div>
      </a>
    ))
  }
</div>

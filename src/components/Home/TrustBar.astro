---
const stats = [
  { value: "5,0", label: "Valoración en Google" },
  { value: "2022", label: "Abiertos en Móstoles" },
  { value: "24 h", label: "Urgencias odontológicas" },
  { value: "0 €", label: "Primera revisión" },
];
---

<section class="up-trust up-on-night" aria-label="La clínica en cifras">
  <div class="up-wrap">
    <ul>
      {stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
    </ul>
  </div>
</section>

---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { etapas } from "@/constants/etapas";
import { treatmentPath } from "@/constants/pages";
import { emergencies, emergencyPhone, whatsappLink } from "@/constants/personal";

const servicios = await getCollection("servicios");
const porSlug = new Map(servicios.map((s) => [s.id, s]));
---

<section class="up-etapas" data-linea-campo="claro" aria-labelledby="etapas-titulo">
  <div class="up-wrap">
    <header class="up-etapas-head up-railed">
      <h2 class="up-h1" id="etapas-titulo">Una clínica para cada etapa de la boca</h2>
      <p class="up-lead">Cada edad tiene sus cuidados. Estos son los nuestros, de la primera visita a los implantes, con el mismo equipo de especialistas.</p>
    </header>

    <ol class="up-etapas-list">
      {etapas.map((e, i) => {
        const enlaces = e.servicios.map((slug) => porSlug.get(slug)).filter((s) => s !== undefined);
        return (
          <li class:list={["up-etapa", i % 2 && "is-par"]} id={e.id}>
            <div class="up-etapa-marca">
              <span class="up-etapa-punto" data-linea-punto />
              <p class="up-etapa-edad">{e.edad}</p>
            </div>
            <div class="up-etapa-texto">
              <h3 class="up-h2">{e.titulo}</h3>
              <p class="up-etapa-edad-movil" aria-hidden="true">{e.edad}</p>
              <p class="up-body">{e.texto}</p>
              <ul class="up-etapa-puntos">
                {e.puntos.map((p) => <li>{p}</li>)}
              </ul>
              <div class="up-etapa-links">
                {enlaces.map((s) => (
                  <a class="up-pill-link" href={treatmentPath(s.id)}>
                    {s.data.titulo}
                    <Icon name="arrow-right" class="up-icon" />
                  </a>
                ))}
              </div>
              <a class="up-link up-link-tap" href={whatsappLink(`Hola, quería pedir cita para ${e.mensaje}.`)} target="_blank" rel="noopener noreferrer">
                Pedir cita para esta etapa<span class="sr-only"> por WhatsApp (se abre en otra pestaña)</span>
              </a>
            </div>
            <figure class="up-etapa-foto">
              <Image src={e.imagen} alt={e.imagenAlt} widths={[480, 720, 960, 1200]} sizes="(min-width: 60em) 36vw, 90vw" quality={76} />
            </figure>
          </li>
        );
      })}

      {emergencies && emergencyPhone && (
        <li class="up-etapa up-etapa-urgencia" id="urgencias">
          <div class="up-etapa-marca">
            <span class="up-etapa-punto is-alerta" data-linea-punto />
            <p class="up-etapa-edad">Cualquier día</p>
          </div>
          <div class="up-etapa-texto">
            <h3 class="up-h2">Y si te duele hoy</h3>
            <p class="up-etapa-edad-movil" aria-hidden="true">Cualquier día</p>
            <p class="up-body">Atendemos {emergencies.long.toLowerCase()}. Llámanos al móvil a cualquier hora.</p>
            <a class="up-tel-grande" href={emergencyPhone.href}>
              <Icon name="phone" class="up-icon" />
              <span class="tabular-nums">{emergencyPhone.display}</span>
            </a>
          </div>
        </li>
      )}
    </ol>
  </div>
</section>

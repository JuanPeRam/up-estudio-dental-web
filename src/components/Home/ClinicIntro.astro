---
// La clínica: el campo de madera clara de la recepción. Fotos reales del local y la tecnología que
// se usa en consulta, como un registro de tres líneas.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import recepcion from "@/img/up/recepcion-equipo.webp";
import gabinete from "@/img/up/tratamiento-sonrisa.webp";
import rx from "@/img/up/radiografia-digital.webp";

const tecnologia = [
  { title: "Escáner intraoral iTero", text: "Las medidas de tu boca en 3D, sin moldes de pasta. Lo ves en pantalla al momento." },
  { title: "Radiografía digital", text: "La panorámica se hace en la clínica y la revisamos contigo, sin ir a otro centro." },
  { title: "Blanqueamiento Philips Zoom", text: "En consulta, en una sesión de una hora y siempre supervisado por el equipo." },
];
---

<section class="up-clinica" id="clinica" data-linea-campo="claro" aria-labelledby="clinica-titulo">
  <div class="up-wrap">
    <div class="up-railed up-clinica-in">
      <span class="up-clinica-punto" data-linea-punto aria-hidden="true"></span>
      <div class="up-clinica-fotos">
        <figure class="is-grande"><Image src={recepcion} alt="Dos profesionales del equipo en la recepción de la clínica" widths={[500, 800, 1100]} sizes="(min-width: 64em) 34vw, 60vw" quality={76} /></figure>
        <figure><Image src={gabinete} alt="Una doctora atiende a un paciente en el gabinete" widths={[400, 700]} sizes="(min-width: 64em) 20vw, 40vw" quality={76} /></figure>
        <figure><Image src={rx} alt="Una doctora señala una radiografía panorámica en la pantalla" widths={[400, 700]} sizes="(min-width: 64em) 20vw, 40vw" quality={76} /></figure>
      </div>
      <div class="up-clinica-texto">
        <h2 class="up-h1" id="clinica-titulo">Una clínica a pie de calle</h2>
        <p class="up-lead">En la calle Andrómeda de Móstoles, desde 2022: luz, madera clara y una sala de espera con rincón de juegos para los peques.</p>
        <dl class="up-registro">
          {tecnologia.map((t) => (
            <div>
              <dt>{t.title}</dt>
              <dd>{t.text}</dd>
            </div>
          ))}
        </dl>
        <a class="up-btn up-btn-secondary" href="/clinica">Recorre la clínica<Icon name="arrow-right" class="up-icon" /></a>
      </div>
    </div>
  </div>
</section>

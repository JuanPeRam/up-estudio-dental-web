---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Button from "@/components/UI/Button.astro";
import Stars from "@/components/UI/Stars.astro";
import { contact } from "@/constants/personal";
import recepcion from "@/img/UP-Gallery/Up-Board.jpg";
---

<section class="up-wrap">
  <div class="up-hero">
    <div class="up-hero-copy">
      <p class="up-eyebrow">Clínica dental familiar en Móstoles</p>
      <h1 class="up-display">Tu dentista de confianza, y el de tus hijos</h1>
      <p class="up-lead">
        Odontología, ortodoncia y medicina estética facial en un espacio pensado para toda la familia, con zona de juegos para
        los peques.
      </p>
      <ul class="up-hero-facts">
        <li><Icon name="check-circle" class="up-icon" />Primera revisión y radiografías gratis</li>
        <li><Icon name="shield" class="up-icon" />Urgencias 24 h</li>
      </ul>
      <div class="flex flex-wrap gap-3">
        <Button href="/contact" icon="calendar">Pedir cita</Button>
        <Button href="/clinic" variant="secondary">Ver la clínica</Button>
      </div>
      <p class="up-rating"><Stars rating={5} /><b>5,0</b> en Google · Desde 2022</p>
    </div>

    <div class="up-hero-media">
      <Image
        src={recepcion}
        alt="Recepción de Up Estudio Dental con el logotipo iluminado"
        widths={[480, 720, 960]}
        sizes="(min-width: 900px) 46vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <aside class="up-hours" aria-label="Horario de hoy">
        <span class="up-hours-urg">Urgencias 24 h</span>
        <dl>
          <dt>Lunes a viernes</dt><dd>10:00–13:30</dd>
          <dt></dt><dd>16:00–20:30</dd>
          <dt>Sábados</dt><dd>10:00–14:00</dd>
        </dl>
        <a class="up-tel" href={contact.landline.href}><Icon name="phone" class="up-icon" />{contact.landline.display}</a>
      </aside>
    </div>
  </div>
</section>

---
import { fixedNumber, phoneNumber } from "@/constants/personal";
import TelephoneIcon from "@/icons/TelephoneIcon";
import HomeIcon from "@/icons/HomeIcon";
import NavButton from "@/components/Templates/NavButton.astro";
import ContactInfo from "../Common/ContactInfo.astro";
---

<section
  class="bg-no-repeat bg-cover bg-center w-full min-h-dvh text-white text-pretty flex justify-center flex-col text-left bg-contrast pt-10 sm:pt-0"
  id="hero-section"
>
  <article class="p-5 flex justify-evenly flex-wrap gap-5 items-center w-full">
    <section
      class="animate-fade-in-down md:animate-fade-in-right border border-primary/50 rounded-md p-5 backdrop-blur-sm"
    >
      <header>
        <p class="font-[700] text-xl text-[rgb(241,241,241)]">¡Bienvenid@s!</p>
        <h1 class="text-2xl md:text-4xl font-[900] uppercase my-8">
          Up Estudio Dental y Estética
        </h1>
      </header>
      <article
        class="font-[500] text-sm text-pretty md:text-base min-h-20 max-w-5xl text-primary/95"
      >
        <p class="italic max-w-[60ch]">
          En UpestudioDental, estamos comprometidos a brindarte una experiencia
          dental excepcional y de calidad.
        </p>
      </article>
      <nav class="flex mt-5 flex-wrap items-center justify-between gap-y-5">  
          <NavButton path="/contact" styles="bg-corporative/80">
            Pide tu cita
          </NavButton>
          <NavButton path="/clinic" styles="bg-secondary">
            Descubre nuestra clinica
          </NavButton>
      </nav>
    </section>
    <ContactInfo></ContactInfo>
  </article>
</section>

<style>
  #hero-section {
    background-image: linear-gradient(
        to top right,
        rgba(19, 19, 19, 0.363),
        rgba(88, 88, 88, 0.671)
      ),
      url("img/UP-Gallery/Up-Board.jpg");
  }
</style>

---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Button from "@/components/UI/Button.astro";
import GoogleRatingBadge from "./GoogleRatingBadge.astro";
import peluche from "@/img/up/peluche-diente.webp";
import { emergencies, emergencyPhone, whatsappLink } from "@/constants/personal";
---

<section class="up-band-aqua">
  <div class="up-wrap up-hero2">
    <div class="flex flex-col gap-6">
      <h1 class="up-display">Clínica dental <em>familiar</em> en Móstoles</h1>
      <p class="up-lead">
        Desde 2022 cuidamos de tu sonrisa y de la de tus hijos con un trato cercano: odontología general, odontopediatría y ortodoncia en un espacio
        pensado para toda la familia.
      </p>
      <ul class="up-perks">
        <li><Icon name="check-circle" class="up-icon" />Primera revisión gratis</li>
        {emergencies && emergencyPhone && (
          <li>
            {/* Sin aria-label: el nombre del enlace es su texto, para que quien navega por voz pueda decir lo que ve. */}
            <a href={emergencyPhone.href}>
              <Icon name="shield" class="up-icon" />{emergencies.short} · <span class="up-perk-tel">{emergencyPhone.display}</span>
            </a>
          </li>
        )}
        <li><Icon name="smile" class="up-icon" />Zona de juegos infantil</li>
      </ul>
      <div class="flex flex-wrap gap-3 pt-2">
        <Button href={whatsappLink("Hola, me gustaría pedir cita.")} icon="whatsapp" external aria-label="Pedir cita por WhatsApp (se abre en otra pestaña)">Pedir cita por WhatsApp</Button>
        <Button href="/tratamientos" variant="secondary">Ver tratamientos</Button>
      </div>
    </div>
    <div class="up-hero2-media">
      <div class="up-arch">
        <Image src={peluche} alt="Miembro del equipo de Up Estudio Dental sonriendo con un peluche de diente" widths={[480, 760, 1040, 1300]} sizes="(min-width: 900px) 520px, 90vw" quality={80} loading="eager" fetchpriority="high" />
      </div>
      <GoogleRatingBadge server:defer />
    </div>
  </div>
</section>

---
// Primera revisión gratuita: el campo oscuro de la portada. Tres partes de la revisión en fila,
// como un registro, y su propia llamada a WhatsApp.
import { Icon } from "astro-icon/components";
import { whatsappLink } from "@/constants/personal";

const items = [
  { title: "Exploración completa", text: "Te exploramos y te explicamos qué vemos, sin prisas." },
  { title: "Radiografías aquí mismo", text: "Las hacemos en la clínica y las revisamos contigo en el momento, sin ir a otro centro." },
  { title: "Presupuesto por escrito", text: "Sabes qué necesitas y cuánto cuesta antes de decidir, sin compromiso." },
];
---

<section class="up-revision up-on-night" id="primera-revision" data-linea-campo="pino" aria-labelledby="revision-titulo">
  <div class="up-wrap">
    <div class="up-revision-in up-railed">
      <span class="up-revision-punto" data-linea-punto aria-hidden="true"></span>
      <div class="up-revision-head">
        <h2 class="up-h1" id="revision-titulo">Tu primera revisión es gratuita</h2>
        <p class="up-lead">Y después, todas las revisiones lo siguen siendo. Así empieza cualquier tratamiento en Up, a cualquier edad.</p>
      </div>
      <dl class="up-revision-list">
        {items.map((it) => (
          <div>
            <dt>{it.title}</dt>
            <dd>{it.text}</dd>
          </div>
        ))}
      </dl>
      <div class="up-revision-cta">
        <a class="up-btn up-btn-light" href={whatsappLink("Hola, me gustaría pedir la primera revisión gratuita.")} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" class="up-icon" />Pedir revisión gratuita<span class="sr-only"> por WhatsApp (se abre en otra pestaña)</span>
        </a>
        <p class="up-small">Te contestamos en horario de clínica. Si no puedes venir, avísanos con 24 horas.</p>
      </div>
    </div>
  </div>
</section>

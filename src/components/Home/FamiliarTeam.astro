---
import { Image } from "astro:assets";
import JuanCarlosTiti from "@/img/Team/juan-carlos.webp";
import NavButton from "@/components/Templates/NavButton.astro";
import TextImageSection from "@/components/Templates/TextImageSection.astro";
---

<TextImageSection
imageSrc={JuanCarlosTiti}
imageAlt="Juan Carlos & Cristina"
articleStyles="min-[1210px]:border-r-0 rounded-l-md min-[1210px]:shadow-none shadow-md min-[1210px]:rounded-r-none rounded-r-md bg-primary"
imageStyles="rounded-r-md min-[1210px]:rounded-l-none rounded-l-md min-[1210px]:shadow-none shadow-md">
  <div slot="title">
    <p class="text-xs font-bold uppercase tracking-widest text-corporative/80 mb-2">Nuestro equipo</p>
    <h2 class="font-bold text-2xl md:text-3xl">Un equipo familiar</h2>
  </div>
  <div slot="text" class="flex flex-col gap-5">
    <p class="max-w-[60ch] text-black/75 leading-relaxed">
      Profesionalidad y dedicación son nuestra seña de identidad. Nos
      mantenemos actualizados con las últimas técnicas y tecnologías,
      garantizando tratamientos de alta calidad y resultados excepcionales,
      con una atención basada en la empatía y el cuidado compasivo.
    </p>
    <ul class="flex flex-col gap-2 text-sm md:text-base text-black/80 font-medium">
      <li class="flex items-center gap-2">
        <span class="text-corporative font-bold">✓</span> Especialistas cualificados en odontología y estética facial
      </li>
      <li class="flex items-center gap-2">
        <span class="text-corporative font-bold">✓</span> Tecnología de vanguardia en cada tratamiento
      </li>
      <li class="flex items-center gap-2">
        <span class="text-corporative font-bold">✓</span> Trato cercano, seguro y personalizado
      </li>
    </ul>
  </div>
  <NavButton slot="button" path="/team" styles="bg-secondary text-white"
    >Nuestro Equipo</NavButton
  >
</TextImageSection>

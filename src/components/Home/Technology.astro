---
// Tecnología: un equipo por tarjeta (el escáner iTero y el escaneo 3D son el mismo aparato),
// agrupados por lo que aportan al paciente: diagnóstico o tratamiento.
import { Image } from "astro:assets";
import SectionHeader from "@/components/UI/SectionHeader.astro";
import zoom from "@/img/up/philips-zoom.webp";
import escaner from "@/img/up/escaner-intraoral.webp";
import rx from "@/img/up/radiografia-digital.webp";

const items = [
  {
    img: escaner,
    alt: "Profesional mostrando en la pantalla el escaneo 3D de una boca",
    tag: "Diagnóstico",
    title: "Escáner intraoral iTero",
    text: "Tomamos las medidas de tu boca en 3D, sin moldes de pasta. Lo ves en pantalla al momento y, si vas a llevar ortodoncia invisible, también cómo quedará.",
  },
  {
    img: rx,
    alt: "Doctora explicando una radiografía panorámica en la pantalla",
    tag: "Diagnóstico",
    title: "Radiografía digital",
    text: "Hacemos la radiografía panorámica en la propia clínica y la revisamos contigo en el momento, sin tener que ir a otro centro.",
  },
  {
    img: zoom,
    alt: "Blanqueamiento dental con lámpara Philips Zoom",
    tag: "Tratamiento",
    title: "Blanqueamiento Philips Zoom",
    text: "Blanqueamiento profesional en consulta, en una sesión de 45 a 60 minutos y siempre supervisado por el equipo.",
  },
];
---

<section class="up-section up-band-night up-on-night" id="tecnologia">
  <div class="up-wrap flex flex-col gap-12">
    <SectionHeader
      align="split"
      eyebrow="Tecnología"
      title="Tecnología que se <em>ve</em> y se entiende"
      lead="Equipos digitales para diagnosticar mejor y explicarte cada paso con tu boca en pantalla."
    />
    <ul class="up-tech">
      {
        items.map((t) => (
          <li>
            <div class="up-arch">
              <Image src={t.img} alt={t.alt} widths={[400, 700, 1000, 1400]} sizes="(min-width: 1000px) 690px, (min-width: 640px) 60vw, 64vw" quality={90} />
            </div>
            <div class="up-tech-text">
              <span class="up-tech-tag">{t.tag}</span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

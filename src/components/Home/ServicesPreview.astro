---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import SectionHeader from "@/components/UI/SectionHeader.astro";
import Button from "@/components/UI/Button.astro";
import { getEspecialidades } from "@/lib/contenido";

const list = (await getEspecialidades()).map((e) => e.data);
---

<section class="up-section" id="especialidades">
  <div class="up-wrap flex flex-col gap-12">
    <SectionHeader
      align="split"
      eyebrow="Especialidades"
      title="Todo tu tratamiento, en la <em>misma</em> clínica"
      lead="De la revisión de los peques a los implantes o la ortodoncia invisible, con especialistas que trabajan juntos en cada caso."
    >
      <div><Button href="/services" variant="ghost" iconAfter="arrow-right">Ver tratamientos y precios</Button></div>
    </SectionHeader>
    <div class="up-specs">
      {
        list.map((s, i) => (
          <a class:list={["up-spec", i === 0 && "is-big"]} href={s.enlace}>
            <Image src={s.imagen} alt={s.imagenAlt} widths={[400, 800, 1200]} sizes={i === 0 ? "(min-width: 900px) 600px, 92vw" : "(min-width: 900px) 300px, 50vw"} quality={90} />
            <span class="up-spec-label">
              <span><b>{s.titulo}</b><small>{s.linea}</small></span>
              <Icon name="arrow-right" class="up-icon" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

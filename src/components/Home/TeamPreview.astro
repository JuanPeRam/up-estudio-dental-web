---
import SectionHeader from "@/components/UI/SectionHeader.astro";
import TeamCard from "@/components/Cards/TeamCard.astro";
import Button from "@/components/UI/Button.astro";
import { team } from "@/db/team";

const featured = ["cristina", "rafael", "isabel"]
  .map((id) => team.find((m) => m.id === id))
  .filter((m): m is (typeof team)[number] => Boolean(m));
---

<section class="up-section up-band-sand" id="equipo">
  <div class="up-wrap flex flex-col gap-12">
    <SectionHeader
      align="split"
      eyebrow="Nuestro equipo"
      title="Especialistas que trabajan como una familia"
      lead="Ortodoncia, odontopediatría, cirugía e implantología, periodoncia e higiene dental, con más de 25 años de experiencia."
    >
      <div><Button href="/team" variant="ghost" iconAfter="arrow-right">Conoce a todo el equipo</Button></div>
    </SectionHeader>
    <div class="up-grid-team">
      {featured.map((m) => <TeamCard id={m.id} name={m.name} roles={m.roles} picture={m.picture} />)}
    </div>
  </div>
</section>

---
import { Image } from "astro:assets";
import SectionHeader from "@/components/UI/SectionHeader.astro";
import Button from "@/components/UI/Button.astro";
import { getEquipo } from "@/lib/contenido";
import { portraitTransition } from "@/constants/pages";
import grupo from "@/img/up/equipo-grupo.webp";

const people = (await getEquipo()).filter((m) => m.data.enPortada).slice(0, 5);
---

<section class="up-section" id="equipo">
  <div class="up-wrap flex flex-col gap-12">
    <SectionHeader
      align="split"
      title="Especialistas que te conocen por tu nombre"
      lead="Odontopediatría, ortodoncia, cirugía e implantes, periodoncia e higiene: más de 25 años de experiencia en un equipo familiar."
    >
      <div><Button href="/equipo" variant="ghost" iconAfter="arrow-right">Conoce a todo el equipo</Button></div>
    </SectionHeader>
    <div class="up-grid-5">
      {
        people.map((m) => (
          <a class="up-cutout" href={`/equipo/${m.id}`}>
            <div class="up-cutout-photo" style={portraitTransition(m.id)}><Image src={m.data.retrato} alt="" widths={[300, 600, 900]} sizes="(min-width: 1100px) 220px, (min-width: 768px) 30vw, 45vw" quality={80} /></div>
            <div class="flex flex-col gap-1">
              <h3 class="up-h4">{m.data.nombre}</h3>
              <p class="up-caption m-0">{m.data.especialidades.slice(0, 3).join(" · ")}</p>
            </div>
          </a>
        ))
      }
    </div>
    <div class="overflow-hidden rounded-lg">
      <Image src={grupo} alt="El equipo de Up Estudio Dental en la clínica" widths={[800, 1400, 2000]} sizes="(min-width: 1264px) 1200px, 100vw" quality={80} class="aspect-[21/9] w-full object-cover" />
    </div>
  </div>
</section>

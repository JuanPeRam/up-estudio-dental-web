---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getEquipo } from "@/lib/contenido";
import { memberPath, portraitTransition } from "@/constants/pages";

// Las personas marcadas «en portada» en Keystatic; la fila se adapta a cuántas haya.
const people = (await getEquipo()).filter((m) => m.data.enPortada);
---

<section class="up-equipo" id="equipo" data-linea-campo="claro" aria-labelledby="equipo-titulo">
  <div class="up-wrap">
    <div class="up-railed up-equipo-in">
      <span class="up-equipo-punto" data-linea-punto aria-hidden="true"></span>
      <header class="up-equipo-head">
        <h2 class="up-h1" id="equipo-titulo">Las mismas manos en cada etapa</h2>
        <p class="up-lead">Un equipo familiar que te conoce por tu nombre: odontopediatría, ortodoncia, cirugía e implantes y periodoncia, bajo el mismo techo.</p>
        <a class="up-link up-link-tap" href="/equipo">Conoce a todo el equipo <Icon name="arrow-right" class="up-icon inline" /></a>
      </header>
      <ul class="up-equipo-list" style={`--n:${Math.min(people.length, 5)}`}>
        {people.map((m) => (
          <li>
            <a class="up-persona" href={memberPath(m.id)}>
              <span class="up-persona-foto up-cutout-photo" style={portraitTransition(m.id)}>
                <Image src={m.data.retrato} alt="" widths={[300, 500, 700]} sizes="(min-width: 64em) 220px, 45vw" quality={78} />
              </span>
              <span class="up-persona-nombre">{m.data.nombre}</span>
              <span class="up-persona-rol">{m.data.especialidades.slice(0, 3).join(" · ")}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

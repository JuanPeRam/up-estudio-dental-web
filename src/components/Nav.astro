---
// nav-split (deal): las palabras a la izquierda, la marca en el centro, la acción principal a la derecha.
// "Tratamientos" abre el panel con cuatro tarjetas de foto (sections-library.md, nav-split).
import { Image } from "astro:assets";
import Logo from "./Logo.astro";
import { services } from "@/constants/services";

interface Props {
  current?: string;
  actionHref: string;
}
const { current, actionHref } = Astro.props;
const cur = (k: string) => (current === k ? "page" : undefined);
---

<header class="nav nav--split">
  <div class="wrap nav__bar">
    <a class="sr-only" href="#top">Saltar al contenido</a>
    <a class="nav__logo" href="/" aria-label="Up Estudio Dental, inicio"><Logo /><span class="up-name">Up Estudio Dental</span></a>
    <nav class="nav__links" aria-label="Principal">
      <div class="nav__item">
        <a class="nav__link" href="/services" aria-current={cur("tratamientos")}>Tratamientos <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            {
              services.map((s) => (
                <a class="menu-card span-3" href={`/services?servicio=${s.slug}`}>
                  <div class="panel"><Image class="frame__img" src={s.image} alt={s.imageAlt} width={560} /></div>
                  <span class="t-card">{s.title}</span>
                  <span class="t-small muted">{s.menuLine}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
      <div class="nav__item"><a class="nav__link" href="/clinic" aria-current={cur("clinica")}>Clínica</a></div>
      <div class="nav__item"><a class="nav__link" href="/team" aria-current={cur("equipo")}>Equipo</a></div>
      <div class="nav__item"><a class="nav__link" href="/contact" aria-current={cur("contacto")}>Contacto</a></div>
    </nav>
    <div class="nav__actions">
      <a class="nav__link" href="tel:+34919931329">919 931 329</a>
      <a class="btn btn--primary" href={actionHref}>Pedir cita</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menú">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
    </button>
  </div>
</header>

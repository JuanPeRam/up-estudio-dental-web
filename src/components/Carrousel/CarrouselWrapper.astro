---
import CarrouselAstro from "@/components/Carrousel/CarrouselAstro.astro";
import Carrousel from "@/components/Carrousel/Carrousel.astro";
---

<section class="column-center p-5">
  <div id="carrousel" class=" p-5 backdrop-blur-md rounded-md block min-[750px]:hidden">
    <Carrousel />
  </div>

  <div
    id="carrouselAstro"
    class="rounded-md animate-blurred-fade-in w-full hidden min-[750px]:block"
  >
    <CarrouselAstro />
  </div>
</section>
---
import gallery from "../../db/gallery";

// Función de orden aleatorio
function randomSort(a: any, b: any) {
  return Math.random() - 0.5;
}

const randomizedGallery = gallery.slice().sort(randomSort);
---

<section
  class="w-full column-center mb-10 p-2 md:p-10"
  id="carrousel-section"
>
  <article class="column-cente w-[50vw]">
    <section class="flex slider h-[60vh] relative w-full" id="slider">
      {
        randomizedGallery.map((image, index) => (
          <img
            decoding={index == 0 ? "sync" : "async"}
            src={image.src}
            alt={image.name}
            class="h-full object-cover opacity-0 transition duration-500 absolute left-0 w-full rounded-md"
          />
        ))
      }
    </section>
    <section class="controls w-full gap-2 mt-5 row-center" id="controls">
      {
        randomizedGallery.map((image, index) => (
          <button class="rounded-full bg-primary p-2" value={index} />
        ))
      }
    </section>
  </article>
</section>

<script defer>
  function init() {
    // Referencias a elementos HTML
    const slider = document.getElementById("slider");
    const controls = document.getElementById("controls");
    const timer = 3000; //miliseconds
    let interval;

    function startInterval() {
      interval = setInterval(() => {
        let newIndex = (currentImageIndex + 1) % images.length;
        handleRadioChange(newIndex);
      }, timer);
    }

    function resetInterval() {
      clearInterval(interval);
      startInterval();
    }

    let currentImageIndex = 0;

    const controlsArray = controls.children;
    const images = slider.children;

    for (let i = 0; i < controlsArray.length; i++) {
      const element = controlsArray[i];
      element.addEventListener("click", () => {
        handleRadioChange(i);
        resetInterval();
      });
      if (i === currentImageIndex) element.classList.add("bg-corporative");
      else element.classList.remove("bg-corporative");
    }

    // Función para cambiar la imagen en el carrusel
    function handleRadioChange(index) {
      const images = slider?.querySelectorAll("img");
      if (images) {
        images[currentImageIndex].style.opacity = 0;
        images[index].style.opacity = 100;
      }
      currentImageIndex = index;

      for (let i = 0; i < controlsArray.length; i++) {
        const element = controlsArray[i];
        if (i === currentImageIndex) {
          element.classList.add("bg-corporative");
          element.classList.remove("bg-primary");
        } else {
          element.classList.remove("bg-corporative");
          element.classList.add("bg-primary");
        }
      }
    }
    handleRadioChange(0);
    startInterval();
  }
  init();
  document.addEventListener("astro:after-swap", init);
</script>

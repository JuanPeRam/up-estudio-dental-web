---
import gallery from "@/db/gallery";
const carrouselLink = "https://codepen.io/onion2k/pen/xxZYBVj";

function randomSort(a: any, b: any) {
  return Math.random() - 0, 5;
}
const randomizedGallery = gallery.slice().sort(randomSort);
---

<section
  class="w-full flex flex-col items-center justify-center pb-10"
  id="carrousel-section"
>
  <article
    class="flex flex-col items-center justify-center px-5 overflow-hidden"
  >
    <p class="text-sm text-right clamp w-full" id="slider-top-text">
      Deslice hacia la izquierda para ver más imágenes
    </p>
    <section class="flex slider w-full h-[60vh] rounded-md" id="sliderAs">
      {
        randomizedGallery.map((image, index) => (
          <img
            decoding={index == 0 ? "async" : "sync"}
            src={image.src}
            alt={image.name}
            class="object-cover left-0 sticky rounded-sm object-center w-full"
          />
        ))
      }
    </section>
  </article>
</section>

<script is:inline>
  function init() {
    const slider = document.getElementById("sliderAs");
    const sliderTopText = document.getElementById("slider-top-text");

    slider.addEventListener("scroll", () => {
      let opacityValue = 1 - slider.scrollLeft / 100;
      opacityValue = Math.max(0, opacityValue);
      sliderTopText.style.opacity = opacityValue;

      if (slider.scrollLeft < 80)
        sliderTopText.style.transform = `translateX(-${slider.scrollLeft}px)`;
    });
  }

  document.addEventListener("astro:after-swap", init);
  init();
</script>

<style>
  .slider {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    position: relative;
    display: flex;
  }

  .slider.img {
    scroll-snap-align: center;
  }
</style>

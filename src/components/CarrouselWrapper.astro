---
import Carrousel from "@/components/CarrouselAstro.astro";
import CarrouselAstro from "@/components/Carrousel.astro";
---

<div id="carrousel" class="hidden">
  <Carrousel />
</div>

<div id="carrouselAstro" class="hidden">
  <CarrouselAstro />
</div>

<script>
  function handleResize() {
    const carousel = document.getElementById("carrousel");
    const carouselAstro = document.getElementById("carrouselAstro");
    const width = window.innerWidth;

    if (width >= 750) {
      carousel.style.display = "block";
      carouselAstro.style.display = "none";
    } else {
      carousel.style.display = "none";
      carouselAstro.style.display = "block";
    }
  }

  window.addEventListener("DOMContentLoaded", handleResize);
  window.addEventListener("resize", handleResize);
  document.addEventListener("astro:after-swap", handleResize);
</script>

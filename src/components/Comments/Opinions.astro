---
import ReviewCard from "./ReviewCard.astro";
import GoogleReviewsCTA from "./GoogleReviewsCTA.astro";
import { getReviews } from "./reviews";
const reviews = await getReviews();
---

<section id="opinions-section">
    <header class="mx-auto max-w-2xl px-4 pb-6 pt-20 text-center">
        <p class="mb-2 text-xs font-bold uppercase tracking-widest text-corporative/80">
            Opiniones
        </p>
        <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">
            Esto es lo que opinan de nosotros nuestros pacientes en Google
        </h2>
    </header>

    <div class="mx-auto flex max-w-screen-xl flex-wrap justify-center gap-x-10 gap-y-16 px-4 pb-20 pt-6 lg:px-6">
        {reviews.map((review, index) => <ReviewCard review={review} index={index} />)}
    </div>

    <GoogleReviewsCTA />
</section>

<style>
    #opinions-section {
        background-image: linear-gradient(
                to top right,
                rgba(19, 19, 19, 0.363),
                rgba(88, 88, 88, 0.671)
            ),
            url("img/UP-Gallery/Box23.jpg");
        background-attachment: fixed;
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
    }
</style>

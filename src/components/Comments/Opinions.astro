---
import SectionHeader from "@/components/UI/SectionHeader.astro";
import ReviewCard from "@/components/Cards/ReviewCard.astro";
import Button from "@/components/UI/Button.astro";
import { contact } from "@/constants/personal";
import { getReviews } from "./reviews";

interface Props { limit?: number }
const { limit = 3 } = Astro.props;
const reviews = (await getReviews()).slice(0, limit);
---

<section class="up-section" id="opiniones">
  <div class="up-wrap flex flex-col gap-12">
    <SectionHeader align="center" eyebrow="Opiniones" title="Lo que dicen nuestros pacientes en Google" />
    <div class="up-grid-3">
      {reviews.map((r) => <ReviewCard review={r} />)}
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href={contact.googleReviewsUrl} variant="secondary" external iconAfter="arrow-right" aria-label="Leer todas las reseñas en Google (se abre en otra pestaña)">Leer todas en Google</Button>
      <Button href={contact.googleReviewsUrl} variant="ghost" external aria-label="Escribir una reseña en Google (se abre en otra pestaña)">Escribir una reseña</Button>
    </div>
  </div>
</section>

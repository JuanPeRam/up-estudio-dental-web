---
import SectionHeader from "@/components/UI/SectionHeader.astro";
import Button from "@/components/UI/Button.astro";
import GoogleReviews from "./GoogleReviews.astro";
import { contact } from "@/constants/personal";

interface Props { limit?: number }
const { limit = 3 } = Astro.props;
---

<section class="up-section" id="opiniones">
  <div class="up-wrap flex flex-col items-center gap-12">
    <SectionHeader align="center" eyebrow="Opiniones" title="Lo que dicen nuestros pacientes en Google" />
    <div class="flex w-full flex-col items-center gap-10">
      <GoogleReviews server:defer limit={limit}>
        <div slot="fallback" class="up-grid-3 w-full" aria-hidden="true">
          {Array.from({ length: limit }, () => <div class="up-review up-review-skeleton" />)}
        </div>
      </GoogleReviews>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href={contact.googleReviewsUrl} variant="secondary" external iconAfter="arrow-right" aria-label="Leer todas las reseñas en Google (se abre en otra pestaña)">Leer todas en Google</Button>
      <Button href={contact.writeReviewUrl} variant="ghost" external aria-label="Escribir una reseña en Google (se abre en otra pestaña)">Escribir una reseña</Button>
    </div>
  </div>
</section>

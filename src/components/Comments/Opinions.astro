---
import SectionHeader from "@/components/UI/SectionHeader.astro";
import GoogleReviews from "./GoogleReviews.astro";

interface Props { limit?: number }
const { limit = 3 } = Astro.props;
---

<!-- La sección entera (titular incluido) la pinta GoogleReviews: con reseñas, el bloque completo; sin ellas,
     una tarjeta compacta. Mientras carga se ve el titular con el esqueleto de las tarjetas. -->
<section class="up-section" id="opiniones">
  <div class="up-wrap">
    <GoogleReviews server:defer limit={limit}>
      <div slot="fallback" class="flex flex-col items-center gap-12">
        <SectionHeader align="center" title="Lo que dicen nuestros pacientes en Google" />
        <div class="up-grid-3 w-full" aria-hidden="true">
          {Array.from({ length: limit }, () => <div class="up-review up-review-skeleton" />)}
        </div>
      </div>
    </GoogleReviews>
  </div>
</section>

<script>
  // Las reseñas llegan después de cargar la página (server island), así que se escucha en el
  // documento. El botón empieza oculto y solo se muestra cuando este script está activo.
  const reveal = () => document.querySelectorAll<HTMLButtonElement>(".up-review-more[hidden]").forEach((b) => (b.hidden = false));
  reveal();
  new MutationObserver(reveal).observe(document.body, { childList: true, subtree: true });

  document.addEventListener("click", (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>(".up-review-more");
    if (!button) return;
    const card = button.closest(".up-review");
    const short = card?.querySelector<HTMLElement>(".up-review-short");
    const full = card?.querySelector<HTMLElement>(".up-review-full");
    if (!short || !full) return;
    const open = button.getAttribute("aria-expanded") !== "true";
    button.setAttribute("aria-expanded", String(open));
    full.hidden = !open;
    short.hidden = open;
    button.querySelector("span")!.textContent = open ? "Ver menos" : "Ver más";
    if (!open) card?.scrollIntoView({ block: "nearest", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  });
</script>

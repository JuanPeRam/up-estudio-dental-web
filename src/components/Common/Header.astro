---
interface Props {
  title: string;
  description: string;
  styles?: string;
}

const { title, description, styles } = Astro.props;
---

<header
  class={`min-h-[20vh] flex-center w-full pt-20 pb-5 flex-col px-10 gap-5 *:max-w-[80ch] ${styles}`}
>
  <h1 class="text-5xl text-center uppercase animate-slide-in-bottom">
    {title}
  </h1>
  <p class="text-pretty animate-slide-in-bottom">
    {description}
  </p>
</header>

---
let path = Astro.url.pathname.replace(/\/$/, "");
if (path == "") path = "/";
import { paths } from "@/constants/pages";
import { Image } from "astro:assets";

import upLogo from "@/img/up-logo-white.png";
---

<nav
  class="flex justify-between items-center z-50 fixed top-0 left-0 w-full px-5 md:px-10 py-3"
  id="header-nav"
  transition:animate="initial"
>
  <a class="w-16 md:w-20 shrink-0 hover:cursor-pointer transition-transform hover:scale-105" href="/" aria-label="Volver a Home">
    <Image alt="Up logo" src={upLogo} loading={"eager"} />
  </a>
  <ul
    class="flex md:before:hidden md:opacity-100 opacity-0 before:bg-secondary/95 md:justify-end justify-center md:bg-transparent items-center invisible md:visible md:flex md:flex-row flex-col fixed md:relative top-0 left-0 h-screen w-full z-20 gap-1 md:gap-1 md:h-fit text-white md:p-0"
    id="menu-navbar"
  >
    {
      Object.entries(paths).map(([key, value]) => (
        <li>
          <a
            href={value}
            class={`nav-item w-fit relative flex justify-center items-center px-4 py-3 text-sm font-semibold tracking-wide transition-colors hover:text-corporative ${path === value ? "text-corporative" : "text-white/90"}`}
          >
            {key}
          </a>
        </li>
      ))
    }
  </ul>
  <button
    id="menu-opener"
    aria-label="Toggle Menu"
    class="md:hidden block hover:bg-secondary/80 p-4 z-40 rounded-full transition-all shrink-0"
  >
    <svg
      class="w-6 h-6 fill-white"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
    >
      <path
        class="navmenu-toggle"
        fill-rule="evenodd"
        d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z"
      >
      </path>

      <path
        class="navmenu-toggle hidden"
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M18.278 16.864a1 1 0 0 1-1.414 1.414l-4.829-4.828-4.828 4.828a1 1 0 0 1-1.414-1.414l4.828-4.829-4.828-4.828a1 1 0 0 1 1.414-1.414l4.829 4.828 4.828-4.828a1 1 0 1 1 1.414 1.414l-4.828 4.829 4.828 4.828z"
      >
      </path>
    </svg>
  </button>
</nav>

<script>
  function addMenuHandler() {
    const menu_opener = document.getElementById("menu-opener");
    const menu = document.getElementById("menu-navbar");
    menu_opener?.addEventListener("click", () => {
      menu?.classList.toggle("invisible");
      menu?.classList.toggle("visible");
    });
  }
  document.addEventListener("astro:after-swap", () => {
    addMenuHandler();
  });
  addMenuHandler();
</script>

<style>
  #menu-navbar {
    transition: opacity 0.45s ease;
  }
  #menu-navbar.visible {
    opacity: 1;
  }
  #menu-navbar::before {
    content: "";
    position: absolute;
    top: 40px;
    right: 40px;
    width: 0;
    height: 0;
    transition: all 0.45s ease;
    border-radius: 50%;
  }

  #menu-navbar.visible::before {
    width: 100vh;
    height: 100vh;
    top: 0;
    right: 10%;
  }

  .nav-item::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 0;
    height: 2px;
    background: #77c6c1;
    border-radius: 2px;
    transition:
      width 0.25s ease,
      left 0.25s ease;
  }

  .nav-item:hover::before,
  .nav-item.text-corporative::before {
    left: 0;
    width: 100%;
  }
</style>

---
import { Icon } from "astro-icon/components";
import { contact, whatsappLink } from "@/constants/personal";
---

<div class="up-mbar" id="mobile-bar" aria-label="Contacto rápido" role="region">
  <a class="up-btn up-btn-secondary" href={contact.landline.href}><Icon name="phone" class="up-icon" />Llamar</a>
  <a class="up-btn up-btn-primary" href={whatsappLink("Hola, me gustaría pedir cita.")} target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp (se abre en otra pestaña)"><Icon name="whatsapp" class="up-icon" />WhatsApp</a>
</div>

<script>
  function initMobileBar() {
    const bar = document.getElementById("mobile-bar");
    if (!bar) return;
    let formFocus = false;
    const update = () => {
      const show = window.scrollY > window.innerHeight * 0.8 && !formFocus;
      document.getElementById("mobile-bar")?.classList.toggle("is-visible", show);
    };
    update();
    const w = window as Window & { __upBar?: boolean };
    if (!w.__upBar) {
      w.__upBar = true;
      window.addEventListener("scroll", update, { passive: true });
      document.addEventListener("focusin", (e) => {
        formFocus = (e.target as HTMLElement).matches?.("input, textarea, select") ?? false;
        update();
      });
      document.addEventListener("focusout", () => {
        formFocus = false;
        update();
      });
    }
  }
  document.addEventListener("astro:page-load", initMobileBar);
</script>

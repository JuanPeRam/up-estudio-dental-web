---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import socials from "@/constants/socials";
import { paths, politicsPaths } from "@/constants/pages";
import { contact, emergencies } from "@/constants/personal";
import upLogo from "@/img/up-logo-white.png";

const year = new Date().getFullYear();
const socialLabel: Record<string, string> = { instagram: "Instagram", tiktok: "TikTok", linkedin: "LinkedIn" };
---

<footer class="up-footer up-on-night">
  <div class="up-wrap">
    <div class="up-footer-grid">
      <div>
        <Image class="up-footer-logo" src={upLogo} alt="Up Estudio Dental y Estética" width={192} />
        <p class="m-0 max-w-[32ch]">Odontología para toda la familia, en Móstoles desde 2022.</p>
      </div>

      <div>
        <h2>Visítanos</h2>
        <ul>
          <li>{contact.address}</li>
          <li>
            <a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2" aria-label="Cómo llegar (abre Google Maps en otra pestaña)">
              <Icon name="pin" class="up-icon" />Cómo llegar
            </a>
          </li>
          {contact.hours.map((h) => <li class="tabular-nums">{h.days ? `${h.days}: ` : ""}{h.time}</li>)}
        </ul>
      </div>

      <div>
        <h2>Contacto</h2>
        <ul>
          <li><a href={contact.landline.href} class="tabular-nums">{contact.landline.display}</a> · fijo</li>
          <li><a href={contact.mobile.href} class="tabular-nums">{contact.mobile.display}</a> · móvil y WhatsApp</li>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          {emergencies && <li class="text-brand">{emergencies.long}</li>}
        </ul>
      </div>

      <div class="flex flex-col gap-8">
        <div>
          <h2>Navega</h2>
          <ul>
            {Object.entries(paths).map(([label, href]) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Síguenos</h2>
          <ul class="up-social">
            {
              socials.map((s) => (
                <li>
                  <a href={s.link} target="_blank" rel="noopener noreferrer" aria-label={`${socialLabel[s.name] ?? s.name} de la clínica (se abre en otra pestaña)`}>
                    <Icon name={s.name} class="up-icon" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="up-footer-legal">
      <span>© {year} Up Estudio Dental y Estética S.L.</span>
      <nav aria-label="Información legal">
        {Object.entries(politicsPaths).map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
    </div>
  </div>
</footer>

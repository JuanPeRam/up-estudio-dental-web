---
import socials from "@/constants/socials";
import ClinicInfo from "@/components/ClinicInfo.astro";
import Iframe from "../Iframe.astro";
import {Icon} from 'astro-icon/components';
import { Image } from "astro:assets";
import upLogo from "@/img/up-logo-white.png";
---

<footer
  class="border-t border-white/10 bg-secondary pt-16 pb-10 px-5"
>
  <div class="max-w-6xl mx-auto flex flex-col items-center gap-14">
    <a href="/" aria-label="Volver a Home" class="w-16 opacity-90 hover:opacity-100 transition">
      <Image alt="Up logo" src={upLogo} />
    </a>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 w-full text-center">
      <article class="flex flex-col items-center gap-3">
        <h2 class="text-sm font-bold uppercase tracking-widest text-corporative">Contáctanos</h2>
        <ClinicInfo />
      </article>
      <article class="flex flex-col items-center gap-3">
        <h2 class="text-sm font-bold uppercase tracking-widest text-corporative">Encuéntranos</h2>
        <Iframe />
      </article>
      <article class="flex flex-col items-center gap-4">
        <h2 class="text-sm font-bold uppercase tracking-widest text-corporative">Síguenos</h2>
        <nav>
          <ul class="flex flex-row gap-x-4 items-center">
            {
              socials.map((media) => (
                <li>
                  <a
                    href={media.link}
                    aria-label={`${media.name} oficial de la clínica`}
                    class="flex items-center justify-center w-11 h-11 border border-white/15 hover:border-corporative hover:bg-corporative hover:text-secondary rounded-full transition-all"
                    rel="noopener"
                    target="_blank"
                  >
                    <Icon name={media.name} width={20} height={20}></Icon>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </article>
    </div>
  </div>
</footer>

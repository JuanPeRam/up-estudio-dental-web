---
import {fixedNumber, phoneNumber} from '../constants/personal'
import TelephoneIcon from '../icons/TelephoneIcon'
import HomeIcon from '../icons/HomeIcon'
---

<section
  class="bg-no-repeat bg-cover bg-center w-full min-h-dvh text-white text-pretty flex justify-center flex-col text-left bg-contrast pt-5 sm:pt-0"
  id="hero-section"
>
  <article class="p-5 w-full flex justify-evenly flex-wrap gap-5 items-center">
    <section class='max-w-[60ch] animate-fade-in-down md:animate-fade-in-right border border-primary/50 rounded-md p-5 backdrop-blur-sm'>
      <header>
      <p
        class="font-[700] text-xl text-[rgb(241,241,241)]"
      >
        ¡Bienvenid@s!
      </p>
      <h1 class="text-2xl md:text-4xl font-[900] uppercase my-8">
        Up Estudio Dental y Estética
      </h1>
      </header>
      <article class="font-[500] text-sm text-pretty md:text-base min-h-20 max-w-5xl text-primary/95">
        <p class="italic">En UpestudioDental, estamos comprometidos a brindarte una experiencia dental excepcional y de calidad.</p>
      </article>
      <nav class="flex mt-5 flex-wrap items-center justify-between gap-y-5">
        <section>
          <a href="/contact" class="cursor-pointer py-3 px-5 shadow-md rounded-3xl bg-corporative/80  font-bold hover:bg-corporative hover:shadow-2xl md:text-base text-sm">
            Pide tu cita
          </a>
        </section>
        <section class="flex">
          <button class="py-3 px-5 shadow-md rounded-3xl font-bold bg-secondary/90 hover:bg-secondary hover:shadow-2xl md:text-base text-sm">Descubre nuestra clínica</button>
        </section>
      </nav>
    </section>
    <article class="font-[700] flex flex-col gap-3 text-center justify-center items-center text-sm md:text-base animate-fade-in-up md:animate-fade-in-left border border-primary/50 rounded-md p-5 backdrop-blur-sm">
      <p>De lunes a viernes 10:00 - 13:30  / 16:00 - 20:30</p>
      <p>Sábados 10:00 - 14:00</p>
      <h3 class="text-sm md:text-xl">URGENCIAS ODONTOLÓGICAS 24h </h3>
      <div class="font-bold">
          <a href={`tel:${phoneNumber}`} class="flex gap-2 hover:bg-secondary/80 rounded-md p-2 transition-colors items-center" aria-label="Link para llamar al número de teléfono de la clínica"><TelephoneIcon height={25} width={25}/>{phoneNumber}</a>
      </div>
      <div class="font-bold">
        <a href={`tel:${fixedNumber}`} class="flex gap-2 hover:bg-secondary/80 rounded-md p-2 transition-colors items-center" aria-label="Link para llamar al número de teléfono de la clínica"><HomeIcon height={25} width={25}/>{fixedNumber}</a>
      </div>
    </article>
  </article>
</section>

<style>
  #hero-section{
    background-image: linear-gradient(to top right, rgba(19, 19, 19, 0.363), rgba(88, 88, 88, 0.671)), url('img/UP-Gallery/Up-Board.jpg');
  }
</style>

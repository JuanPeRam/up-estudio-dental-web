---
import gallery from "@/db/gallery";
const carrouselLink = "https://codepen.io/onion2k/pen/xxZYBVj";

function randomSort(a: any, b: any) {
  return Math.random() - 0, 5;
}
const randomizedGallery = gallery.slice().toSorted(randomSort);
---

<section
  class="w-full flex flex-col items-center justify-center"
  id="carrousel-section"
>
  <article class="flex flex-col items-center justify-center px-5">
    <section class="flex slider w-full h-[60vh] rounded-md">
      {
        randomizedGallery.map((image) => (
          <img
            src={image.src}
            alt={image.name}
            class="object-cover left-0 sticky rounded-sm object-center w-full"
          />
        ))
      }
    </section>
  </article>
</section>

<style>
  .slider {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    position: relative;
    display: flex;
  }

  .slider.img {
    scroll-snap-align: center;
  }
</style>

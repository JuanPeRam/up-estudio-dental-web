---
import gallery from "@/db/gallery";
const carrouselLink = "https://codepen.io/onion2k/pen/xxZYBVj";
---

<section
  class="h-screen w-full flex flex-col items-center justify-center"
  id="carrousel-section"
>
  <article class="flex flex-col items-center justify-center">
    <section class="flex slider">
      {
        gallery.map((image) => (
          <img
            src={image.src}
            alt={image.name}
            class="object-cover w-full left-0 sticky rounded-sm object-center"
          />
        ))
      }
    </section>
  </article>
</section>

<style>
  .slider {
    scroll-snap-type: x mandatory;
    overflow-x: scroll;

    aspect-ratio: 10/16;
    height: 600px;
    position: relative;
    display: flex;
  }

  .slider.img {
    scroll-snap-align: center;
  }
</style>

---
import SteticTreatment from "./SteticTreatment.astro";
import ServiceIntro from "./ServiceIntro.astro";
import CTABand from "@/components/UI/CTABand.astro";

// Fotos de tratamiento propias de la clínica, alojadas en su antigua web (Wix).
const data = [
    {
        image: "https://static.wixstatic.com/media/d47f72_8c917bab172e4a74b2b3e2a25c98d647~mv2.jpg/v1/fill/w_600,h_450,al_c,q_80,usm_0.66_1.00_0.01,enc_auto/236a56a9-b8ae-4d28-aeb2-0c5e4f62d9ff.jpg",
        title: "Rejuvenecimiento facial",
        text: "Un relleno dérmico que se aplica en el rostro para suavizar arrugas, líneas de expresión y pliegues. Además estimula el colágeno natural, devolviendo elasticidad y luminosidad a la piel con un resultado natural y duradero.",
        highlights: ["Sesión de 30-45 min", "Resultado progresivo", "Sin ingreso"],
    },
    {
        image: "https://static.wixstatic.com/media/d47f72_e253b93cd8e84ffa8d6735ad3d53d8bc~mv2.jpg/v1/fill/w_600,h_450,al_c,q_80,usm_0.66_1.00_0.01,enc_auto/33149c9b-fafa-4cd1-9578-f0ee68d80120.jpg",
        title: "Tratamiento de arrugas",
        text: "Suavizamos las arrugas de la frente, el entrecejo y el contorno de los ojos relajando de forma controlada la musculatura que las provoca. Es rápido, ambulatorio y vuelves a tu rutina el mismo día.",
        highlights: ["Sesión de 20 min", "Efecto a los 3-7 días", "Duración de 4 a 6 meses"],
    },
    {
        image: "https://static.wixstatic.com/media/d47f72_667407e82a1a40d5a28302715497d902~mv2.jpg/v1/fill/w_600,h_450,al_c,q_80,usm_0.66_1.00_0.01,enc_auto/WhatsApp%20Image%202024-04-25%20at%2013_52_12%20(1).jpg",
        title: "Aumento de labios con ácido hialurónico",
        text: "Aportamos volumen al labio y definimos su forma, corrigiendo pequeñas asimetrías cuando hace falta. Es uno de los procedimientos más naturales, porque el ácido hialurónico lo genera nuestro propio organismo.",
        highlights: ["Sesión de 30 min", "Resultado inmediato", "Reabsorbible"],
    },
];
---

<section class="up-section" id="medicina-estetica">
    <div class="up-wrap flex flex-col gap-16 lg:gap-24">
        <ServiceIntro
            title="Medicina estética"
            lead="Tratamientos faciales con productos reabsorbibles y un criterio conservador: que se te vea descansado/a, no que se note el tratamiento. Todo empieza por una consulta en la que valoramos tu rostro y decidimos juntos qué merece la pena hacer."
        />
        {
            data.map((item, index) => (
                <SteticTreatment title={item.title} image={item.image} text={item.text} highlights={item.highlights} reversed={index % 2 === 1} />
            ))
        }
    </div>
</section>

<CTABand
    eyebrow="Consulta previa"
    service="un tratamiento de medicina estética"
    title="Cuéntanos qué te gustaría mejorar"
    description="Valoramos tu caso en consulta antes de proponerte nada, y solo hacemos lo que de verdad merece la pena."
/>

---
/**
 * Ficha de un tratamiento, construida a partir de src/content/servicios/<slug>.yaml (editable en /keystatic).
 * Cada bloque opcional solo aparece si tiene elementos.
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ServiceIntro from "./ServiceIntro.astro";
import ProcessSteps from "@/components/UI/ProcessSteps.astro";
import Checklist from "@/components/UI/Checklist.astro";
import Accordion from "@/components/UI/Accordion.astro";
import Notice from "@/components/UI/Notice.astro";
import CTABand from "@/components/UI/CTABand.astro";
import Button from "@/components/UI/Button.astro";
import { contact } from "@/constants/personal";

interface Props {
    service: CollectionEntry<"servicios">;
}
const { service } = Astro.props;
const d = service.data;

const facts = d.datos.filter((f) => f.valor).map((f) => ({ icon: f.icono, label: f.etiqueta, value: f.valor }));
const pasos = (d.pasos?.items ?? []).filter((p) => p.titulo).map((p) => ({ title: p.titulo, text: p.texto }));
const incluye = (d.incluye?.items ?? []).filter(Boolean);
const tarjetas = (d.tarjetas?.items ?? []).filter((t) => t.titulo);
const beneficios = (d.beneficios?.items ?? []).filter(Boolean);
const preguntas = (d.preguntas?.items ?? []).map((p) => ({ question: p.pregunta, answer: p.respuesta }));

// Con pasos, la columna derecha lleva «Qué incluye» o, si no hay, las preguntas frecuentes.
const preguntasJuntoAPasos = pasos.length > 0 && incluye.length === 0 && preguntas.length > 0;
---

<section class="up-section" id={service.id}>
    <div class="up-wrap flex flex-col gap-16 lg:gap-20">
        <ServiceIntro badge={d.etiqueta || undefined} title={d.titulo} lead={d.entradilla} facts={facts.length ? facts : undefined} />

        {
            pasos.length > 0 && (
                <div class:list={["grid gap-12 lg:gap-16", incluye.length ? "lg:grid-cols-[1.4fr_1fr]" : "lg:grid-cols-2"]}>
                    <div class="flex flex-col gap-8">
                        {d.pasos?.titulo && <h3 class="up-h3">{d.pasos.titulo}</h3>}
                        <ProcessSteps steps={pasos} />
                    </div>
                    {incluye.length > 0 && (
                        <aside class="up-panel up-panel-sticky h-fit">
                            {d.incluye?.titulo && <h3 class="up-h3">{d.incluye.titulo}</h3>}
                            <Checklist items={incluye} />
                            <Button href="/contact" icon="calendar" block>{d.incluye?.boton || "Pedir cita"}</Button>
                        </aside>
                    )}
                    {preguntasJuntoAPasos && (
                        <div class="flex flex-col gap-8">
                            <h3 class="up-h3">{d.preguntas?.titulo || "Preguntas frecuentes"}</h3>
                            <Accordion items={preguntas} openFirst />
                        </div>
                    )}
                </div>
            )
        }

        {
            pasos.length === 0 && incluye.length > 0 && (
                <aside class="up-panel max-w-xl">
                    {d.incluye?.titulo && <h3 class="up-h3">{d.incluye.titulo}</h3>}
                    <Checklist items={incluye} />
                    <Button href="/contact" icon="calendar" block>{d.incluye?.boton || "Pedir cita"}</Button>
                </aside>
            )
        }

        {
            tarjetas.length > 0 && (
                <div class="flex flex-col gap-8">
                    {d.tarjetas?.titulo && <h3 class="up-h3">{d.tarjetas.titulo}</h3>}
                    <div class="up-grid-4">
                        {tarjetas.map((t) => (
                            <article class="up-panel gap-2 p-6">
                                <h4 class="up-h4">{t.titulo}</h4>
                                {t.texto && <p class="up-small">{t.texto}</p>}
                            </article>
                        ))}
                    </div>
                </div>
            )
        }

        {
            beneficios.length > 0 && (
                <div class="grid gap-8 rounded-md bg-tint p-6 sm:p-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
                    <div class="flex flex-col gap-3">
                        {d.beneficios?.antetitulo && <p class="up-eyebrow">{d.beneficios.antetitulo}</p>}
                        {d.beneficios?.titulo && <h3 class="up-h2">{d.beneficios.titulo}</h3>}
                        {d.beneficios?.texto && <p class="up-small">{d.beneficios.texto}</p>}
                    </div>
                    <Checklist items={beneficios} />
                </div>
            )
        }

        {
            d.tratamientos.map((t, i) => (
                <article class:list={["up-treat", i % 2 === 1 && "is-reversed"]}>
                    <figure class="up-treat-media m-0">
                        <Image src={t.imagen} alt={t.imagenAlt} widths={[600, 1000]} sizes="(min-width: 1024px) 560px, 100vw" />
                    </figure>
                    <div class="flex flex-col gap-5">
                        <h3 class="up-h2">{t.titulo}</h3>
                        {t.texto && <p class="up-body">{t.texto}</p>}
                        {t.puntos.length > 0 && <Checklist items={t.puntos} />}
                    </div>
                </article>
            ))
        }

        {
            preguntas.length > 0 && !preguntasJuntoAPasos && (
                <div class="flex max-w-3xl flex-col gap-8">
                    <h3 class="up-h3">{d.preguntas?.titulo || "Preguntas frecuentes"}</h3>
                    <Accordion items={preguntas} openFirst />
                </div>
            )
        }

        {
            d.avisoCancelacion && (
                <Notice>
                    <b>Política de cancelación.</b> Confirma o anula tu cita llamando con antelación al {contact.landline.display} o al {contact.mobile.display} (también por WhatsApp). Sin confirmación previa no podemos garantizar la disponibilidad.
                </Notice>
            )
        }
    </div>
</section>

<CTABand
    eyebrow={d.cierre.antetitulo || undefined}
    service={d.cierre.mensajeWhatsapp || d.titulo.toLowerCase()}
    title={d.cierre.titulo}
    description={d.cierre.texto || undefined}
/>

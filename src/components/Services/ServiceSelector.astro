---
import { services } from "@/constants/services";

interface Props {
    active: string;
}

const { active } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" id="service-selector">
    {
        services.map((service) => {
            const isActive = service.slug === active;
            return (
                <a
                    href={`/services?servicio=${service.slug}#detalle`}
                    aria-current={isActive ? "true" : undefined}
                    class:list={[
                        "group flex flex-col overflow-hidden rounded-xl border transition-all duration-200",
                        isActive
                            ? "border-corporative bg-corporative/10 shadow-lg shadow-corporative/10"
                            : "border-white/10 bg-secondary/80 hover:-translate-y-1 hover:border-corporative/50",
                    ]}
                >
                    <div class="relative h-36 w-full overflow-hidden">
                        <img
                            src={service.image}
                            alt={`Fotografía de ${service.title}`}
                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                            loading="lazy"
                        />
                        {isActive && (
                            <span class="row-center absolute right-3 top-3 h-7 w-7 rounded-full bg-corporative text-sm font-bold text-secondary">
                                ✓
                            </span>
                        )}
                    </div>
                    <div class="flex flex-col gap-1 p-5">
                        <h3 class="text-lg font-bold">{service.title}</h3>
                        <p class="text-sm text-textSecondary">{service.shortDescription}</p>
                        <span
                            class:list={[
                                "mt-2 text-sm font-bold",
                                isActive
                                    ? "text-corporative"
                                    : "text-white/60 group-hover:text-corporative",
                            ]}
                        >
                            {isActive ? "Viendo este servicio ↓" : "Ver detalles →"}
                        </span>
                    </div>
                </a>
            );
        })
    }
</div>

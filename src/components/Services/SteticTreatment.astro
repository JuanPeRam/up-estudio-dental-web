---
import Checklist from "@/components/UI/Checklist.astro";

interface Props {
    title: string;
    image: string;
    text: string;
    highlights: string[];
    /** Invierte el orden de imagen y texto para el patrón en zigzag */
    reversed?: boolean;
}

const { image, text, title, highlights, reversed = false } = Astro.props;
---

<article class:list={["up-treat", reversed && "is-reversed"]}>
    <figure class="up-treat-media m-0">
        <img src={image} alt={`Tratamiento de ${title.toLowerCase()}`} loading="lazy" decoding="async" width="600" height="450" />
    </figure>
    <div class="flex flex-col gap-5">
        <h3 class="up-h2">{title}</h3>
        <p class="up-body">{text}</p>
        <Checklist items={highlights} />
    </div>
</article>

---
interface Props{
    title: string;
    image: string,
    text: string
}

const {image, text, title} = Astro.props
---

<article class="flex flex-col items-center gap-10 backdrop-blur-md  rounded-md px-10 py-7 shadow-md border">
    <img src={image} alt=`Imagen de ${title}` class="rounded-full transition ">
    <h2 class="text-xl text-blackTitle font-bold">{title}</h2>
    <p class="max-w-[40ch] text-base text-blackBodyText">{text}</p>
</article>
---
import { Icon } from "astro-icon/components";

interface Fact {
    icon: string;
    label: string;
    value: string;
}

interface Props {
    facts: Fact[];
    styles?: string;
}

const { facts, styles = "" } = Astro.props;
---

<ul class={`flex flex-wrap gap-3 ${styles}`}>
    {
        facts.map((fact) => (
            <li class="flex items-center gap-3 rounded-full border border-white/15 bg-secondary/80 py-2 pl-3 pr-5">
                <span class="row-center h-9 w-9 shrink-0 rounded-full bg-corporative/20 text-corporative">
                    <Icon name={fact.icon} height={18} width={18} />
                </span>
                <span class="flex flex-col leading-tight">
                    <span class="text-[0.65rem] uppercase tracking-widest text-corporative">
                        {fact.label}
                    </span>
                    <span class="text-sm font-bold">{fact.value}</span>
                </span>
            </li>
        ))
    }
</ul>

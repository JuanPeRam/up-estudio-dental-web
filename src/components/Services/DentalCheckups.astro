---
import ServiceFacts from "./ServiceFacts.astro";
import ServiceCTA from "./ServiceCTA.astro";

const facts = [
    { icon: "euro", label: "Precio", value: "Gratuita" },
    { icon: "clock", label: "Duración", value: "15 min aprox." },
    { icon: "book", label: "Frecuencia", value: "1 o 2 veces al año" },
];

const steps = [
    {
        title: "Primera toma de contacto",
        text: "Repasamos contigo tu historial médico, los tratamientos que ya te hayan hecho y el motivo de tu visita. Si vienes por una molestia concreta, empezamos por ahí.",
    },
    {
        title: "Exploración de la boca",
        text: "Revisamos diente a diente el estado del esmalte, buscamos caries, desgastes, coloraciones y comprobamos la salud de las encías y la posición de la mordida.",
    },
    {
        title: "Estudio radiográfico",
        text: "Realizamos las radiografías necesarias para ver lo que no se aprecia a simple vista: raíces, hueso, muelas del juicio y caries interdentales.",
    },
    {
        title: "Diagnóstico y presupuesto",
        text: "Te explicamos con claridad qué hemos encontrado y qué opciones tienes. Si hace falta tratamiento, te entregamos el presupuesto detallado por escrito, sin ningún compromiso.",
    },
];

const included = [
    "Revisión clínica completa",
    "Radiografías necesarias para el diagnóstico",
    "Plan de tratamiento personalizado",
    "Presupuesto cerrado y por escrito",
    "Consejos de higiene adaptados a tu caso",
];
---

<section
    class="bg-secondary/80 px-4 py-12 sm:py-20 lg:px-6"
    id="dental-checkups"
>
    <div class="mx-auto max-w-screen-xl">
        <div class="mb-12 max-w-screen-md lg:mb-16">
            <span
                class="mb-4 inline-block rounded-full bg-corporative px-4 py-1 text-xs font-bold uppercase tracking-widest text-secondary"
                >Sin coste</span
            >
            <h2 class="mb-4 text-4xl font-extrabold tracking-tight">
                Revisiones Dentales
            </h2>
            <p class="text-pretty">
                Revisión, estudio radiográfico, diagnóstico y presupuesto totalmente
                gratuitos. Una visita periódica es la forma más sencilla de detectar a
                tiempo caries, desgastes o problemas de encías, cuando todavía son
                fáciles de tratar.
            </p>
            <ServiceFacts facts={facts} styles="mt-8" />
        </div>

        <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
            <div>
                <h3 class="mb-8 text-2xl font-bold">Cómo es tu visita, paso a paso</h3>
                <ol class="relative flex flex-col gap-10 border-l border-white/15 pl-8">
                    {
                        steps.map((step, index) => (
                            <li class="relative">
                                <span class="absolute -left-[3.05rem] row-center h-10 w-10 rounded-full border border-corporative/40 bg-secondary font-bold text-corporative">
                                    {index + 1}
                                </span>
                                <h4 class="mb-2 text-xl font-bold">{step.title}</h4>
                                <p class="text-pretty">{step.text}</p>
                            </li>
                        ))
                    }
                </ol>
            </div>

            <aside
                class="h-fit rounded-xl border border-white/15 bg-secondary p-8 lg:sticky lg:top-28"
            >
                <h3 class="mb-6 text-xl font-bold">Qué incluye</h3>
                <ul class="flex flex-col gap-4">
                    {
                        included.map((item) => (
                            <li class="flex items-start gap-3">
                                <span
                                    class="mt-1 shrink-0 text-corporative"
                                    aria-hidden="true"
                                >
                                    ✓
                                </span>
                                <span class="text-sm text-textSecondary">{item}</span>
                            </li>
                        ))
                    }
                </ul>
            </aside>
        </div>
    </div>
</section>

<ServiceCTA
    service="una revisión dental"
    title="Reserva tu revisión gratuita"
    description="La primera visita no te cuesta nada y te llevas un diagnóstico completo con presupuesto por escrito."
/>

---
import ServiceIntro from "./ServiceIntro.astro";
import ProcessSteps from "@/components/UI/ProcessSteps.astro";
import Checklist from "@/components/UI/Checklist.astro";
import Notice from "@/components/UI/Notice.astro";
import CTABand from "@/components/UI/CTABand.astro";
import Button from "@/components/UI/Button.astro";
import { contact } from "@/constants/personal";

const facts = [
    { icon: "euro", label: "Precio", value: "Gratuita" },
    { icon: "clock", label: "Duración", value: "15 min aprox." },
    { icon: "repeat", label: "Frecuencia", value: "1 o 2 veces al año" },
];

const steps = [
    { title: "Primera toma de contacto", text: "Repasamos contigo tu historial médico, los tratamientos que ya te hayan hecho y el motivo de tu visita. Si vienes por una molestia concreta, empezamos por ahí." },
    { title: "Exploración de la boca", text: "Revisamos diente a diente el estado del esmalte, buscamos caries, desgastes y coloraciones, y comprobamos la salud de las encías y la posición de la mordida." },
    { title: "Estudio radiográfico", text: "Hacemos las radiografías necesarias para ver lo que no se aprecia a simple vista: raíces, hueso, muelas del juicio y caries interdentales." },
    { title: "Diagnóstico y presupuesto", text: "Te explicamos con claridad qué hemos encontrado y qué opciones tienes. Si hace falta tratamiento, te entregamos el presupuesto detallado por escrito, sin compromiso." },
];

const included = [
    "Revisión clínica completa",
    "Radiografías necesarias para el diagnóstico",
    "Plan de tratamiento personalizado",
    "Presupuesto cerrado y por escrito",
    "Consejos de higiene adaptados a tu caso",
];
---

<section class="up-section" id="revisiones-dentales">
    <div class="up-wrap flex flex-col gap-16">
        <ServiceIntro
            badge="Sin coste"
            title="Revisiones dentales"
            lead="Revisión, estudio radiográfico, diagnóstico y presupuesto totalmente gratuitos. Una visita periódica es la forma más sencilla de detectar a tiempo caries, desgastes o problemas de encías, cuando todavía son fáciles de tratar."
            facts={facts}
        />

        <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
            <div class="flex flex-col gap-8">
                <h3 class="up-h3">Cómo es tu visita, paso a paso</h3>
                <ProcessSteps steps={steps} />
            </div>
            <aside class="up-panel up-panel-sticky h-fit">
                <h3 class="up-h3">Qué incluye</h3>
                <Checklist items={included} />
                <Button href="/contact" icon="calendar" block>Pedir revisión gratuita</Button>
            </aside>
        </div>

        <Notice>
            <b>Política de cancelación.</b> Confirma o anula tu cita llamando con antelación al {contact.landline.display} o al {contact.mobile.display} (también por WhatsApp). Sin confirmación previa no podemos garantizar la disponibilidad.
        </Notice>
    </div>
</section>

<CTABand
    eyebrow="Primera visita"
    service="una revisión dental"
    title="Reserva tu revisión gratuita"
    description="La primera visita no te cuesta nada y te llevas un diagnóstico completo con presupuesto por escrito."
/>

---
import { Icon } from "astro-icon/components";
import ServiceCTA from "./ServiceCTA.astro";

const signs = [
    {
        title: "Sangrado al cepillarte",
        text: "Es la primera señal de gingivitis. Una encía sana no sangra, por mucho que la cepilles.",
    },
    {
        title: "Mal aliento persistente",
        text: "La placa acumulada entre el diente y la encía libera compuestos que el cepillado no llega a arrastrar.",
    },
    {
        title: "Manchas o sarro visible",
        text: "El sarro se ve como una banda amarillenta en la base del diente y ya no se elimina en casa.",
    },
    {
        title: "Sensación de encía inflamada",
        text: "Encías rojas, hinchadas o que se retraen dejando el diente más largo de lo habitual.",
    },
];

const benefits = [
    "Previene caries y enfermedad periodontal",
    "Frena el sangrado y la inflamación de encías",
    "Elimina manchas de café, té y tabaco",
    "Mejora el aliento de forma inmediata",
    "Deja la superficie pulida, para que la placa tarde más en volver",
];
---

<section
    class="bg-secondary/80 px-4 py-12 sm:py-20 lg:px-6"
    id="dental-cleaning-section"
>
    <div class="mx-auto grid max-w-screen-xl gap-12 lg:grid-cols-[22rem_1fr] lg:gap-16">
        <aside
            class="h-fit rounded-xl border border-white/15 bg-secondary p-8 lg:sticky lg:top-28"
        >
            <h2 class="mb-6 text-3xl font-extrabold tracking-tight">Limpieza Bucal</h2>
            <dl class="flex flex-col gap-6">
                <div class="flex items-start gap-4">
                    <span
                        class="row-center h-11 w-11 shrink-0 rounded-full bg-corporative/20 text-corporative"
                    >
                        <Icon name="euro" height={20} width={20} />
                    </span>
                    <div>
                        <dt class="text-xs uppercase tracking-widest text-corporative">
                            Precio
                        </dt>
                        <dd class="text-sm text-textSecondary">
                            Consúltalo sin compromiso en tu cita de valoración.
                        </dd>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span
                        class="row-center h-11 w-11 shrink-0 rounded-full bg-corporative/20 text-corporative"
                    >
                        <Icon name="clock" height={20} width={20} />
                    </span>
                    <div>
                        <dt class="text-xs uppercase tracking-widest text-corporative">
                            Duración
                        </dt>
                        <dd class="text-sm text-textSecondary">
                            Entre 30 y 45 minutos, en una única sesión.
                        </dd>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span
                        class="row-center h-11 w-11 shrink-0 rounded-full bg-corporative/20 text-corporative"
                    >
                        <Icon name="book" height={20} width={20} />
                    </span>
                    <div>
                        <dt class="text-xs uppercase tracking-widest text-corporative">
                            Frecuencia
                        </dt>
                        <dd class="text-sm text-textSecondary">
                            Al menos una vez al año; cada seis meses si tienes tendencia
                            a acumular sarro.
                        </dd>
                    </div>
                </div>
            </dl>
        </aside>

        <div class="flex flex-col gap-14">
            <div>
                <h3 class="mb-4 text-2xl font-bold">En qué consiste</h3>
                <p class="text-pretty">
                    Mediante ultrasonidos retiramos el sarro y la placa bacteriana
                    adheridos a la superficie del diente y bajo la línea de la encía,
                    justo donde el cepillo no llega. Después pulimos el esmalte con una
                    pasta profiláctica para dejarlo liso, de modo que la placa tarde más
                    en volver a depositarse. Es un procedimiento indoloro; si tienes los
                    dientes sensibles, adaptamos la potencia del equipo y podemos aplicar
                    un gel desensibilizante.
                </p>
            </div>

            <div>
                <h3 class="mb-6 text-2xl font-bold">Señales de que ya te toca</h3>
                <div class="grid gap-4 sm:grid-cols-2">
                    {
                        signs.map((sign) => (
                            <article class="rounded-xl border border-white/10 bg-secondary/40 p-6 transition-colors hover:border-corporative/50">
                                <h4 class="mb-2 font-bold text-corporative">
                                    {sign.title}
                                </h4>
                                <p class="text-sm">{sign.text}</p>
                            </article>
                        ))
                    }
                </div>
            </div>

            <div>
                <h3 class="mb-6 text-2xl font-bold">Qué notarás después</h3>
                <ul class="flex flex-col gap-3">
                    {
                        benefits.map((benefit) => (
                            <li class="flex items-start gap-3 border-b border-white/10 pb-3 last:border-0">
                                <span class="mt-1 shrink-0 text-corporative" aria-hidden="true">
                                    ✓
                                </span>
                                <span class="text-textSecondary">{benefit}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

<ServiceCTA
    service="una limpieza bucal"
    title="Pide tu limpieza bucal"
    description="Una sesión al año basta para mantener a raya el sarro. Escríbenos y buscamos el hueco que mejor te venga."
/>

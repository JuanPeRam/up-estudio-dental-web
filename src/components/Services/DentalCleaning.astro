---
import ServiceIntro from "./ServiceIntro.astro";
import Checklist from "@/components/UI/Checklist.astro";
import CTABand from "@/components/UI/CTABand.astro";

const facts = [
    { icon: "euro", label: "Precio", value: "Según valoración" },
    { icon: "clock", label: "Duración", value: "30-45 min, una sesión" },
    { icon: "repeat", label: "Frecuencia", value: "Al menos 1 vez al año" },
];

const signs = [
    { title: "Sangrado al cepillarte", text: "Es la primera señal de gingivitis. Una encía sana no sangra, por mucho que la cepilles." },
    { title: "Mal aliento persistente", text: "La placa acumulada entre el diente y la encía libera compuestos que el cepillado no llega a arrastrar." },
    { title: "Manchas o sarro visible", text: "El sarro se ve como una banda amarillenta en la base del diente y ya no se elimina en casa." },
    { title: "Encía inflamada", text: "Encías rojas, hinchadas o que se retraen dejando el diente más largo de lo habitual." },
];

const benefits = [
    "Previene caries y enfermedad periodontal",
    "Frena el sangrado y la inflamación de encías",
    "Elimina manchas de café, té y tabaco",
    "Mejora el aliento de forma inmediata",
    "Deja la superficie pulida, para que la placa tarde más en volver",
];
---

<section class="up-section" id="limpieza-bucal">
    <div class="up-wrap flex flex-col gap-16">
        <ServiceIntro
            title="Limpieza bucal"
            lead="Retiramos con ultrasonidos el sarro y la placa adheridos al diente y bajo la encía, justo donde el cepillo no llega. Después pulimos el esmalte para que la placa tarde más en volver. Es indoloro; si tienes los dientes sensibles, ajustamos la potencia y aplicamos un gel desensibilizante."
            facts={facts}
        />

        <div class="flex flex-col gap-8">
            <h3 class="up-h3">Señales de que ya te toca</h3>
            <div class="up-grid-4">
                {
                    signs.map((s) => (
                        <article class="up-panel gap-2 p-6">
                            <h4 class="up-h4">{s.title}</h4>
                            <p class="up-small">{s.text}</p>
                        </article>
                    ))
                }
            </div>
        </div>

        <div class="grid gap-8 rounded-md bg-tint p-6 sm:p-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
            <div class="flex flex-col gap-3">
                <p class="up-eyebrow">Después de la limpieza</p>
                <h3 class="up-h2">Qué notarás al salir</h3>
                <p class="up-small">Una sesión al año basta para mantener a raya el sarro; cada seis meses si tienes tendencia a acumularlo.</p>
            </div>
            <Checklist items={benefits} />
        </div>
    </div>
</section>

<CTABand
    service="una limpieza bucal"
    title="Pide tu limpieza bucal"
    description="Escríbenos y buscamos el hueco que mejor te venga. Si hace más de un año de la última, es buen momento."
/>

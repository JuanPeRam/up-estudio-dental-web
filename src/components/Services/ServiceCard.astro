---
interface Props {
    title: string;
    description?: string;
    image: string;
    href: string;
}

const { href, image, title, description } = Astro.props;
import NavButton from "../Templates/NavButton.astro";
---

<article class="flex flex-col items-start justify-center shadow-md group">
    <div class="w-full relative">
        <img
            src={image}
            alt={`Fotografía de ${title}`}
            class="object-cover w-full h-full group-hover:brightness-110 transition"
            loading="lazy"
        />
    </div>

    <div
        class="p-5 flex flex-col items-start justify-center w-full backdrop-blur-md group-hover:bg-contrast/20 transition h-full"
    >
        <h2 class="py-5 text-xl text-left">{title}</h2>
        <p>{description}</p>
        <NavButton path={href} styles="bg-secondary text-sm"> + Info </NavButton>
    </div>
</article>

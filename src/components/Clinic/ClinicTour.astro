---
// Visita guiada por la clínica: paradas en el orden en que las recorre un paciente,
// con un índice que acompaña al scroll y un visor para ampliar las fotos.
import { Image, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import Button from "@/components/UI/Button.astro";
import tour from "@/db/clinicTour";
import { contact } from "@/constants/personal";

let index = 0;
const stops = await Promise.all(
  tour.map(async (stop) => ({
    ...stop,
    photos: await Promise.all(
      stop.photos.map(async (photo) => ({
        ...photo,
        index: index++,
        large: (await getImage({ src: photo.src, width: 1600 })).src,
      })),
    ),
  })),
);
const total = stops.length;
const pad = (n: number) => String(n).padStart(2, "0");

/**
 * Ancho que necesita cada foto. Las fotos (3:2) se recortan para llenar su caja, así que en cajas
 * más verticales que la foto hace falta más ancho que el de la caja (ver .up-tour-photos en el CSS).
 */
const tourSizes = (count: number, index: number) => {
  // Dos fotos: cajas de alto clamp(240px, 34vw, 440px) → ancho necesario = alto × 1,5
  if (count === 2) return "(min-width: 1024px) 660px, clamp(360px, 51vw, 660px)";
  // La primera ocupa todo el ancho en 3:2, igual que la foto
  if (index === 0) return "(min-width: 1024px) 640px, 100vw";
  // Resto: media columna en 4:3 → 1,125 veces el ancho de la caja
  return "(min-width: 1024px) 340px, 57vw";
};
---

<nav class="up-tour-index" aria-label="Paradas de la visita">
  <ol class="up-wrap">
    {
      stops.map((s, i) => (
        <li>
          <a href={`#${s.id}`} data-stop={s.id}>
            <span aria-hidden="true">{i + 1}</span>
            {s.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<div id="tour">
  {
    stops.map((s, i) => (
      <section class:list={["up-section up-tour-stop", i % 2 === 1 && "up-band-sand"]} id={s.id} aria-labelledby={`${s.id}-title`}>
        <div class:list={["up-wrap up-tour-grid", i % 2 === 1 && "is-reversed"]}>
          <div class="up-tour-text">
            <p class="up-tour-step">
              <span class="up-tour-num" aria-hidden="true">{pad(i + 1)}</span>
              <span>
                Parada {i + 1} de {total} · {s.label}
              </span>
            </p>
            <h2 class="up-h2" id={`${s.id}-title`}>{s.title}</h2>
            <p class="up-lead">{s.text}</p>
            <ul class="up-checks">
              {s.details.map((d) => (
                <li>
                  <Icon name="check" class="up-icon" />
                  {d}
                </li>
              ))}
            </ul>
            {i === 0 && (
              <div>
                <Button href={contact.mapsUrl} variant="secondary" icon="pin" external aria-label="Cómo llegar (abre Google Maps en otra pestaña)">
                  Cómo llegar
                </Button>
              </div>
            )}
            {i < total - 1 ? (
              <a class="up-tour-next" href={`#${stops[i + 1].id}`}>
                Siguiente parada: {stops[i + 1].label}
                <Icon name="arrow-right" class="up-icon rotate-90" />
              </a>
            ) : (
              <p class="up-small">Fin de la visita. ¿Te la enseñamos en persona?</p>
            )}
          </div>
          <div class="up-tour-photos" data-count={s.photos.length}>
            {s.photos.map((p, j) => (
              <button type="button" data-index={p.index} data-large={p.large} aria-label={`Ampliar foto: ${p.alt}`}>
                <Image
                  src={p.src}
                  alt={p.alt}
                  widths={[400, 800, 1200, 1600]}
                  sizes={tourSizes(s.photos.length, j)}
                  quality={85}
                />
              </button>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</div>

<div class="up-lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Visor de fotos de la clínica" hidden>
  <button class="up-lightbox-btn right-4 top-4 md:right-6 md:top-6" type="button" id="lightbox-close" aria-label="Cerrar visor"><Icon name="close" class="up-icon" /></button>
  <button class="up-lightbox-btn left-2 top-1/2 -translate-y-1/2 md:left-6" type="button" id="lightbox-prev" aria-label="Foto anterior"><Icon name="chevron-left" class="up-icon" /></button>
  <img id="lightbox-image" alt="" />
  <button class="up-lightbox-btn right-2 top-1/2 -translate-y-1/2 md:right-6" type="button" id="lightbox-next" aria-label="Foto siguiente"><Icon name="chevron-right" class="up-icon" /></button>
  <p class="up-lightbox-count m-0" id="lightbox-counter" aria-live="polite"></p>
</div>

<script>
  function initTour() {
    const root = document.getElementById("tour");
    const box = document.getElementById("lightbox");
    if (!root || !box || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    // Índice: marca la parada que se está viendo.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".up-tour-index a[data-stop]"));
    const setCurrent = (id: string) => {
      links.forEach((a) => {
        const on = a.dataset.stop === id;
        if (on) a.setAttribute("aria-current", "step");
        else a.removeAttribute("aria-current");
        // Centra el chip moviendo solo la barra del índice: scrollIntoView cortaría el scroll de la página.
        const bar = a.closest("ol");
        if (on && bar) bar.scrollTo({ left: a.offsetLeft - (bar.clientWidth - a.offsetWidth) / 2, behavior: "smooth" });
      });
    };
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && setCurrent(e.target.id)),
      { rootMargin: "-45% 0px -50% 0px" },
    );
    root.querySelectorAll("section[id]").forEach((s) => observer.observe(s));

    // Visor de fotos.
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-index]")).sort(
      (a, b) => Number(a.dataset.index) - Number(b.dataset.index),
    );
    const image = document.getElementById("lightbox-image") as HTMLImageElement;
    const counter = document.getElementById("lightbox-counter")!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + buttons.length) % buttons.length;
      const btn = buttons[current];
      const thumb = btn.querySelector("img");
      image.src = btn.dataset.large ?? thumb?.src ?? "";
      image.alt = thumb?.alt ?? "";
      counter.textContent = `${current + 1} / ${buttons.length}`;
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") close();
      else if (e.key === "ArrowRight") show(current + 1);
      else if (e.key === "ArrowLeft") show(current - 1);
    };
    const open = (i: number, from: HTMLElement) => {
      opener = from;
      show(i);
      box.hidden = false;
      document.body.style.overflow = "hidden";
      document.addEventListener("keydown", onKey);
      document.getElementById("lightbox-close")?.focus();
    };
    const close = () => {
      box.hidden = true;
      document.body.style.overflow = "";
      document.removeEventListener("keydown", onKey);
      opener?.focus();
    };

    buttons.forEach((b) => b.addEventListener("click", () => open(Number(b.dataset.index), b)));
    document.getElementById("lightbox-close")?.addEventListener("click", close);
    document.getElementById("lightbox-prev")?.addEventListener("click", () => show(current - 1));
    document.getElementById("lightbox-next")?.addEventListener("click", () => show(current + 1));
    box.addEventListener("click", (e) => {
      if (e.target === box) close();
    });
  }
  initTour();
</script>

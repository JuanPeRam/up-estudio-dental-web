---
import { Icon } from "astro-icon/components";
import Stars from "@/components/UI/Stars.astro";
import type { Review } from "@/components/Comments/reviews";

interface Props { review: Review; maxChars?: number }
const { review, maxChars = 260 } = Astro.props;
const { author_name, profile_photo_url, rating, relative_time_description } = review;
const clean = review.text.replace(/\s+/g, " ").trim();
const text = clean.length > maxChars ? `${clean.slice(0, clean.lastIndexOf(" ", maxChars))}…` : clean;
const initials = author_name.split(" ").slice(0, 2).map((w) => w[0]).join("").toUpperCase();
---

<figure class="up-review">
  <Stars rating={rating} />
  <blockquote>«{text}»</blockquote>
  <figcaption>
    <span class="up-avatar" aria-hidden="true">
      {profile_photo_url ? <img src={profile_photo_url} alt="" loading="lazy" referrerpolicy="no-referrer" /> : initials}
    </span>
    <div>
      <b>{author_name}</b>
      <span class="up-caption">{relative_time_description}</span>
    </div>
    <Icon name="google" class="up-g" aria-label="Reseña de Google" />
  </figcaption>
</figure>

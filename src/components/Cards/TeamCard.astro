---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  member: CollectionEntry<"equipo">;
  headingLevel?: "h2" | "h3";
}
const { member, headingLevel: H = "h3" } = Astro.props;
const d = member.data;
---

<a class="up-cutout" href={`/equipo/${member.id}`}>
  <div class="up-cutout-photo">
    <Image src={d.retrato} alt="" widths={[360, 700, 1000]} sizes="(min-width: 1000px) 380px, 45vw" />
  </div>
  <div class="flex flex-col gap-2">
    <H class="up-h4">{d.nombre}</H>
    {d.especialidades.length > 0 && <div class="up-team-roles">{d.especialidades.slice(0, 3).map((r) => <span class="up-badge">{r}</span>)}</div>}
  </div>
</a>

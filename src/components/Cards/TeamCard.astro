---
interface Props {
  id: string;
  name: string;
  roles?: string[];
  picture: string;
  headingLevel?: "h2" | "h3";
}
const { id, name, roles = [], picture, headingLevel: H = "h3" } = Astro.props;
---

<a class="up-team" href={`/member/${id}`}>
  <div class="up-team-photo">
    <img src={`/${picture}`} alt={name} loading="lazy" decoding="async" width="420" height="525" transition:name={`${id}-image`} />
  </div>
  <div class="flex flex-col gap-2">
    <H class="up-h4">{name}</H>
    {roles.length > 0 && <div class="up-team-roles">{roles.slice(0, 3).map((r) => <span class="up-badge">{r}</span>)}</div>}
  </div>
</a>

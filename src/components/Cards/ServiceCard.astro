---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { treatmentPath } from "@/constants/pages";

interface Props {
  service: CollectionEntry<"servicios">;
  active?: boolean;
  headingLevel?: "h2" | "h3";
}
const { service, active = false, headingLevel: H = "h3" } = Astro.props;
const d = service.data;
---

<a class="up-scard" href={treatmentPath(service.id)} aria-current={active ? "true" : undefined}>
  <div class="up-scard-media">
    <Image src={d.imagen} alt={d.imagenAlt} widths={[400, 640]} sizes="(min-width: 1080px) 380px, (min-width: 900px) 33vw, (min-width: 640px) 42vw, 100vw" />
  </div>
  <div class="up-scard-body">
    {d.etiqueta && <span class="up-badge">{d.etiqueta}</span>}
    <H class="up-h3">{d.titulo}</H>
    <p class="up-small">{d.resumen}</p>
    <span class="up-scard-more">
      {active ? "Estás viendo este tratamiento" : "Ver el tratamiento"}
      <Icon name={active ? "check" : "arrow-right"} class="up-icon" />
    </span>
  </div>
</a>

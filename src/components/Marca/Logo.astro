---
/**
 * Logotipo de Up teñido con el color del texto que lo rodea (currentColor): la silueta blanca del PNG
 * se usa como máscara. Así el mismo archivo sirve en pino sobre crema y en crema sobre pino.
 * Falta una versión vectorial (TODO.md).
 */
interface Props { size?: number; class?: string; /** Solo el símbolo, sin el texto curvo (ilegible a tamaño de cabecera). */ simbolo?: boolean }
const { size = 56, class: extra, simbolo = true } = Astro.props;
---

<span class:list={["up-logo", simbolo && "is-simbolo", extra]} style={`--logo:${size}px`} aria-hidden="true"></span>

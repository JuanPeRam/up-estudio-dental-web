---
const path = Astro.url.pathname;
import { paths } from "@/constants/pages";
const selectedClass = "font-bold border-b";
---

<nav
  class="flex justify-between flex-row-reverse items-center z-50 fixed top-0 left-0 w-full px-5"
  id="header-nav"
>
  <button
    id="menu-opener"
    aria-label="Toggle Menu"
    class="md:hidden block hover:bg-black/10 p-5 z-40 rounded-full transition-all"
  >
    <svg
      class="w-6 h-6 fill-white"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
    >
      <path
        class="navmenu-toggle"
        fill-rule="evenodd"
        d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z"
      >
      </path>

      <path
        class="navmenu-toggle hidden"
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M18.278 16.864a1 1 0 0 1-1.414 1.414l-4.829-4.828-4.828 4.828a1 1 0 0 1-1.414-1.414l4.828-4.829-4.828-4.828a1 1 0 0 1 1.414-1.414l4.829 4.828 4.828-4.828a1 1 0 1 1 1.414 1.414l-4.828 4.829 4.828 4.828z"
      >
      </path>
    </svg>
  </button>
  <ul
    class="italic flex flex-wrap md:justify-end justify-center md:bg-transparent items-center invisible md:visible md:flex md:flex-row flex-col fixed md:relative top-0 left-0 h-screen w-full z-20 gap-5 bg-secondary/70 md:gap-0 md:h-fit text-white md:p-0"
    id="menu-navbar"
  >
  {
    Object.entries(paths).map(([key,value])=>(
      <li>
        <a href={value} 
        class=`nav-item ${path === value ? selectedClass : ""}`
        >
          {key}
        </a>
      </li>
    ))
  }
  </ul>
  <a class="w-20 hover:" href="/">
    <img src="img/up-logo.png">
  </a>
</nav>

<script>
    function addMenuHandler(){
      const menu_opener = document.getElementById("menu-opener");
      const menu = document.getElementById("menu-navbar");
      menu_opener?.addEventListener("click", () => {
        menu?.classList.toggle("invisible");
      });
    }
    document.addEventListener('astro:after-swap', ()=>{
      addMenuHandler()
    })
    addMenuHandler()
</script>

<style>
  .nav-item {
    padding: 0.95rem;
    display: flex;
    justify-content: center;
    align-items: center;
    width: fit-content;
  }
</style>

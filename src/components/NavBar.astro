---
const path = Astro.url.pathname;
import {paths} from '@/constants/pages'
---

<nav class="flex justify-center items-center w-full h-full">
  <ul class="flex italic flex-wrap justify-center">
    <li>
      <a href={paths.Home} class="navItem">Inicio</a>
    </li>
    <li>
      <a
        href={paths.Clinic}
        class=`navItem ${path == "/clinic" ? "bg-slate-500" : ''}`
        >Nuestra Clínica</a
      >
    </li>
    <li><a href={paths.Services} class="navItem">Servicios</a></li>
    <li><a href={paths.Team} class="navItem">Nuestro Equipo</a></li>
    <li><a href={paths.Messages} class="navItem">Testimonios</a></li>
    <li><a href={paths.Contact} class="navItem">Contacto</a></li>
  </ul>
</nav>

<style>
  .navItem {
    padding: 1.25rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>

---
const path = Astro.url.pathname;
import {paths} from '@/constants/pages'
const selectedClass = "font-bold border-b"
---

<nav class="flex justify-center items-center z-50 sticky top-0 left-0 bg-white/50 w-full" id="header-nav">
  <button id="menu-opener" aria-label="Toggle Menu" class="md:hidden block hover:bg-gray-200 p-5 z-40">
    <svg class="w-6 h-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
      <path class="navmenu-toggle" fill-rule="evenodd"
        d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z">
      </path>

      <path class="navmenu-toggle hidden" fill-rule="evenodd" clip-rule="evenodd"
        d="M18.278 16.864a1 1 0 0 1-1.414 1.414l-4.829-4.828-4.828 4.828a1 1 0 0 1-1.414-1.414l4.828-4.829-4.828-4.828a1 1 0 0 1 1.414-1.414l4.829 4.828 4.828-4.828a1 1 0 1 1 1.414 1.414l-4.828 4.829 4.828 4.828z">
      </path>
    </svg>
  </button>
  <ul class="italic flex-wrap justify-center items-center hidden md:flex md:flex-row flex-col absolute md:relative top-0 left-0 h-screen w-full z-20 gap-20 bg-gray-500/50 md:bg-none md:gap-0 md:h-fit" id="menu-navbar">
    <li>
      <a href={paths.Home} 
      class=`nav-item ${path === paths.Home ? selectedClass : ""}`>Inicio</a>
    </li>
    <li>
      <a
        href={paths.Clinic}
        class=`nav-item ${path === paths.Clinic ? selectedClass : ''}`
        >Nuestra Clínica</a
      >
    </li>
    <li><a href={paths.Services} class=`nav-item ${path === paths.Services ? selectedClass:""}`>Servicios</a></li>
    <li><a href={paths.Team} class=`nav-item ${path === paths.Team ? selectedClass:""}`>Nuestro Equipo</a></li>
    <li><a href={paths.Messages} class=`nav-item ${path === paths.Messages ? selectedClass:""}`>Testimonios</a></li>
    <li><a href={paths.Contact} class=`nav-item ${path === paths.Contact ? selectedClass:""}`>Contacto</a></li>
  </ul>
</nav>

<script>
  const menu_opener = document.getElementById('menu-opener')
  const menu = document.getElementById('menu-navbar')

  menu_opener.addEventListener('click',()=>{
    menu.classList.toggle('hidden')
    menu.classList.toggle('flex')
  })
</script>

<style>
  .nav-item {
    padding: 0.95rem;
    display: flex;
    justify-content: center;
    align-items: center;
    width: fit-content;
  }
</style>

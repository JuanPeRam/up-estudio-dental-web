---
// La visita (system.css .visit): dirección, cómo llegar, horario con el día de hoy y la fachada al lado.
import { Image } from "astro:assets";
import { contact } from "@/constants/personal";
import fachada from "@/img/UP-Gallery/Up-Entry.jpg";
---

<section class="section" id="como-llegar" aria-labelledby="llegar-h">
  <div class="wrap">
    <div class="grid grid--top fill">
      <div class="span-6 stack-6">
        <div class="section-head"><h2 id="llegar-h">Cómo llegar</h2><p>En planta baja, con la puerta a pie de calle.</p></div>
        <div class="stack-4">
          <address class="visit__address">C. Andrómeda, 48<br />28938 Móstoles, Madrid</address>
          <a class="link" href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">Abrir en Google Maps</a>
        </div>
        <dl class="hours" data-tz="Europe/Madrid">
          <dt data-days="mon-fri">Lunes a viernes</dt><dd>10:00–13:30<br />16:00–20:30</dd>
          <dt data-days="sat">Sábado</dt><dd>10:00–14:00</dd>
          <dt data-days="sun">Domingo</dt><dd>Cerrado</dd>
        </dl>
        <ul class="visit__rows">
          <li><span>Teléfono</span><a href={contact.landline.href}>{contact.landline.display}</a></li>
          <li><span>Urgencias 24 h y WhatsApp</span><a href={contact.mobile.href}>{contact.mobile.display}</a></li>
        </ul>
      </div>
      <div class="frame frame--photo frame--fill span-6 start-7">
        <Image class="frame__img" src={fachada} alt="Fachada de Up Estudio Dental en la calle Andrómeda" widths={[680]} sizes="(min-width: 1024px) 628px, 100vw" data-source="client" data-subject="la fachada" />
      </div>
    </div>
  </div>
</section>
